---
// Root page with IP-based language detection and redirect
export const prerender = false; // This needs to run on the server to detect IP

// Country to language mapping
const countryLanguageMap: Record<string, string> = {
  // French-speaking countries/regions
  'FR': 'fr', 'BE': 'fr', 'CH': 'fr', 'CA': 'fr', 'SN': 'fr', 'CI': 'fr', 'ML': 'fr', 'BF': 'fr', 'NE': 'fr', 'TD': 'fr', 'MG': 'fr', 'CM': 'fr', 'CD': 'fr', 'CG': 'fr', 'GA': 'fr', 'CF': 'fr', 'DJ': 'fr', 'KM': 'fr', 'MC': 'fr', 'LU': 'fr',
  
  // Spanish-speaking countries
  'ES': 'es', 'MX': 'es', 'AR': 'es', 'CO': 'es', 'PE': 'es', 'VE': 'es', 'CL': 'es', 'EC': 'es', 'GT': 'es', 'CU': 'es', 'BO': 'es', 'DO': 'es', 'HN': 'es', 'PY': 'es', 'SV': 'es', 'NI': 'es', 'CR': 'es', 'PA': 'es', 'UY': 'es', 'PR': 'es',
  
  // German-speaking countries
  'DE': 'de', 'AT': 'de', 'LI': 'de',
  
  // Portuguese-speaking countries
  'PT': 'pt', 'BR': 'pt', 'AO': 'pt', 'MZ': 'pt', 'CV': 'pt', 'GW': 'pt', 'ST': 'pt', 'TL': 'pt',
  
  // Japanese-speaking countries
  'JA': 'ja',
  
  // Korean-speaking countries
  'KR': 'ko', 'KP': 'ko',
  
  // Chinese-speaking countries/regions
  'CN': 'zh', 'TW': 'zh', 'HK': 'zh', 'MO': 'zh', 'SG': 'zh',
  
  // Arabic-speaking countries
  'SA': 'ar', 'AE': 'ar', 'EG': 'ar', 'IQ': 'ar', 'JO': 'ar', 'LB': 'ar', 'KW': 'ar', 'QA': 'ar', 'BH': 'ar', 'OM': 'ar', 'YE': 'ar', 'SY': 'ar', 'LY': 'ar', 'TN': 'ar', 'DZ': 'ar', 'MA': 'ar', 'SD': 'ar', 'PS': 'ar', 'MR': 'ar',
  
  // English-speaking countries (fallback)
  'US': 'en', 'GB': 'en', 'AU': 'en', 'NZ': 'en', 'IE': 'en', 'ZA': 'en', 'NG': 'en', 'KE': 'en', 'GH': 'en', 'UG': 'en', 'TZ': 'en', 'ZW': 'en', 'ZM': 'en', 'BW': 'en', 'MW': 'en', 'SZ': 'en', 'LS': 'en', 'JM': 'en', 'TT': 'en', 'BB': 'en', 'BS': 'en', 'AG': 'en', 'GD': 'en', 'KN': 'en', 'LC': 'en', 'VC': 'en', 'DM': 'en', 'MT': 'en', 'CY': 'en'
};

async function detectLanguageFromIP(): Promise<string> {
  try {
    // Get IP from request headers
    const forwardedFor = Astro.request.headers.get('x-forwarded-for');
    const realIP = Astro.request.headers.get('x-real-ip');
    const ip = forwardedFor?.split(',')[0]?.trim() || realIP || 'unknown';
    
    if (ip === 'unknown' || ip === '127.0.0.1' || ip.startsWith('192.168.') || ip.startsWith('10.') || ip.startsWith('172.')) {
      // Local development or private IP, default to English
      return 'en';
    }
    
    // Use ipapi.co to get country from IP
    const response = await fetch(`https://ipapi.co/${ip}/country/`, {
      headers: {
        'User-Agent': 'Mozilla/5.0 (compatible; Astro-Site/1.0)'
      }
    });
    
    if (response.ok) {
      const countryCode = await response.text();
      if (countryCode && countryCode.length === 2) {
        const language = countryLanguageMap[countryCode.toUpperCase()];
        if (language) {
          return language;
        }
      }
    }
    
    // Fallback to English if country not found or API fails
    return 'en';
  } catch (error) {
    console.error('Error detecting language from IP:', error);
    return 'en'; // Default to English on error
  }
}

// Detect language and redirect
const detectedLanguage = await detectLanguageFromIP();

// Get the full URL with port for proper redirect
const host = Astro.request.headers.get('host') || 'localhost:3001';
const protocol = Astro.request.headers.get('x-forwarded-proto') || 'http';
const redirectUrl = `${protocol}://${host}/${detectedLanguage}`;

// Return redirect response
return Astro.redirect(redirectUrl, 302);
---
