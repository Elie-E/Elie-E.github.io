const content = articleContent[lang as keyof typeof articleContent] || articleContent.en;
---

<Layout 
  title={title}
  description={description}
  canonical={canonical}
  currentPath={currentPath}
  currentLang={currentLang}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <!-- Back to Blog -->
      <div class="mb-8">
        <a href={`/${lang}/blog/`} class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 font-medium">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          {content.backToBlog}
        </a>
      </div>

      <!-- Article Header -->
      <header class="mb-12">
        <div class="flex items-center gap-2 mb-4">
          <span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm">
            {content.category}
          </span>
          <span class="text-sm text-gray-600">{content.publishedOn} 2024-01-20</span>
          <span class="text-sm text-gray-600">*</span>
          <span class="text-sm text-gray-600">{content.readTime}</span>
        </div>
        
        <h1 class="text-3xl md:text-4xl font-bold mb-6 leading-tight">
          {content.title}
        </h1>
        
        <p class="text-lg text-gray-600 leading-relaxed">
          {content.metaDescription}
        </p>
      </header>

      <!-- Article Content -->
      <article class="prose prose-lg max-w-none">
        <!-- Introduction -->
        <section class="mb-8">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            {content.introduction}
          </p>
          <p class="text-lg text-gray-600 leading-relaxed">
            {content.introParagraph}
          </p>
        </section>

        <!-- Why Local Development Matters -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6">{content.whyLocalDevMatters}</h2>
          <p class="text-lg text-gray-600 mb-4">{content.whyLocalDevIntro}</p>
          
          <ul class="space-y-3 mb-6">
            <li class="flex items-start">
              <span class="w-2 h-2 bg-blue-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-gray-700">{content.speed}</span>
            </li>
            <li class="flex items-start">
              <span class="w-2 h-2 bg-blue-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-gray-700">{content.consistency}</span>
            </li>
            <li class="flex items-start">
              <span class="w-2 h-2 bg-blue-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-gray-700">{content.isolation}</span>
            </li>
          </ul>
          
          <p class="text-lg text-gray-600 font-medium">
            {content.dockerSolves}
          </p>
        </section>

        <!-- Docker Benefits -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6">{content.dockerBenefits}</h2>
          
          <!-- Rapid Onboarding -->
          <div class="mb-8">
            <h3 class="text-xl font-semibold mb-4">{content.rapidOnboarding}</h3>
            <p class="text-gray-700 mb-4">{content.rapidOnboardingDesc}</p>
            
            <div class="bg-gray-900 text-green-400 p-4 rounded-lg font-mono text-sm mb-4">
              {content.dockerComposeCommand}
            </div>
            
            <p class="text-gray-700">{content.rapidOnboardingResult}</p>
          </div>

          <!-- Reproducible Environments -->
          <div class="mb-8">
            <h3 class="text-xl font-semibold mb-4">{content.reproducibleEnvironments}</h3>
            <p class="text-gray-700">{content.reproducibleEnvironmentsDesc}</p>
          </div>

          <!-- Built-In Isolation -->
          <div class="mb-8">
            <h3 class="text-xl font-semibold mb-4">{content.builtInIsolation}</h3>
            <p class="text-gray-700">{content.builtInIsolationDesc}</p>
          </div>
        </section>

        <!-- Example -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6">{content.exampleTitle}</h2>
          <p class="text-gray-700 mb-4">{content.exampleDesc}</p>
          
          <div class="bg-gray-900 text-green-400 p-6 rounded-lg font-mono text-sm overflow-x-auto">
            <pre>{content.dockerComposeExample}</pre>
          </div>
          
          <p class="text-gray-700 mt-4 mb-2">{content.withOneCommand}</p>
          <ul class="space-y-2">
            <li class="flex items-start">
              <span class="w-2 h-2 bg-green-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-gray-700">{content.phpBackend}</span>
            </li>
            <li class="flex items-start">
              <span class="w-2 h-2 bg-green-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-gray-700">{content.nodeFrontend}</span>
            </li>
            <li class="flex items-start">
              <span class="w-2 h-2 bg-green-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-gray-700">{content.mysqlDatabase}</span>
            </li>
          </ul>
        </section>

        <!-- Why Team Loves It -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6">{content.whyTeamLoves}</h2>
          
          <ul class="space-y-3 mb-6">
            <li class="flex items-start">
              <span class="w-2 h-2 bg-purple-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-gray-700">{content.hotReloading}</span>
            </li>
            <li class="flex items-start">
              <span class="w-2 h-2 bg-purple-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-gray-700">{content.debugging}</span>
            </li>
            <li class="flex items-start">
              <span class="w-2 h-2 bg-purple-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-gray-700">{content.consistency}</span>
            </li>
          </ul>
          
          <div class="bg-blue-50 border-l-4 border-blue-400 p-4 rounded">
            <p class="text-blue-800 font-medium">{content.setupTime}</p>
          </div>
        </section>

        <!-- Best Practices -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6">{content.bestPractices}</h2>
          
          <ul class="space-y-3">
            <li class="flex items-start">
              <span class="w-2 h-2 bg-orange-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-gray-700">{content.useVolumes}</span>
            </li>
            <li class="flex items-start">
              <span class="w-2 h-2 bg-orange-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-gray-700">{content.addMakefile}</span>
            </li>
            <li class="flex items-start">
              <span class="w-2 h-2 bg-orange-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-gray-700">{content.keepLightweight}</span>
            </li>
            <li class="flex items-start">
              <span class="w-2 h-2 bg-orange-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-gray-700">{content.documentCompose}</span>
            </li>
          </ul>
        </section>

        <!-- Conclusion -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6">{content.conclusion}</h2>
          <p class="text-lg text-gray-700 mb-6">{content.conclusionText}</p>
          <p class="text-lg text-gray-700 font-medium">{content.finalCall}</p>
        </section>
      </article>

      <!-- Share Section -->
      <section class="border-t pt-8 mt-12">
        <div class="text-center">
          <h3 class="text-lg font-semibold mb-4">{content.shareArticle}</h3>
          <div class="flex justify-center gap-4">
            <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(content.title)}&url=${encodeURIComponent(canonical)}`} 
               target="_blank" 
               rel="noopener noreferrer"
               class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors">
              Twitter
            </a>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`} 
               target="_blank" 
               rel="noopener noreferrer"
               class="px-4 py-2 bg-blue-700 text-white rounded-lg hover:bg-blue-800 transition-colors">
              LinkedIn
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
  
