const title = `Docker for Local Dev: Spinning Up Projects in Minutes - ${personalInfo.name}`;
const description = `Learn how Docker simplifies local development. Discover how to bootstrap PHP, JavaScript, and full-stack projects in minutes with reproducible environments.`;

