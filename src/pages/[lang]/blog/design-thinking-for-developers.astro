      "نحن نفكر: طرق متعددة لتبديل اللغات (قائمة منسدلة، كشف تلقائي).",
      "نحن نبني نموذجاً أولياً: نبني مفتاح تبديل سريع.",
      "نحن نختبر: المستخدمون الحقيقيون يؤكدون ما إذا كان المفتاح بديهياً."
    ],
    exampleResult: "النتيجة ليست مجرد نموذج - إنها تجربة مدروسة وصديقة للمستخدم.",
    lessonsForDevelopers: "دروس للمطورين الذين يريدون التفكير كمصممين",
    lessons: [
      "ابدأ دائماً من منظور المستخدم.",
      "لا تستخف بالبساطة - تصميم أدنى، كود أدنى.",
      "ارسم أو ارسم مخططاً للحلول قبل البرمجة - مثل الإطار السلكي.",
      "كرر بسرعة، لا تهدف للكمال من اليوم الأول."
    ],
    conclusion: "الخلاصة",
    conclusionText: "رحلتي من مصمم الشعارات إلى CTO قد تبدو غير عادية، لكن الحقيقة هي: التصميم والتطوير مترابطان بعمق. الإبداع والتعاطف وحل المشاكل التي تعلمتها من خلال التصميم ما زالت تشكل كودي وقيادتي اليوم.",
    finalCall: "إذا كنت مطوراً، حاول تبني التفكير التصميمي. لا يتعلق الأمر بجعل الأشياء تبدو جميلة - يتعلق بجعلها تعمل بجمال.",
    backToBlog: "العودة إلى المدونة",
    shareArticle: "مشاركة المقال",
    readTime: "8 دقائق قراءة",
    publishedOn: "نشر في",
    category: "Leadership"
  }
};

const content = articleContent[lang as keyof typeof articleContent] || articleContent.en;
---

<Layout 
  title={title}
  description={description}
  canonical={canonical}
  currentPath={currentPath}
  currentLang={currentLang}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <!-- Back to Blog -->
      <div class="mb-8">
        <a href={`/${lang}/blog/`} class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 font-medium">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          {content.backToBlog}
        </a>
      </div>

      <!-- Article Header -->
      <header class="mb-12">
        <div class="flex items-center gap-2 mb-4">
          <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm">
            {content.category}
          </span>
          <span class="text-sm text-gray-600">{content.publishedOn} 2024-01-25</span>
          <span class="text-sm text-gray-600">*</span>
          <span class="text-sm text-gray-600">{content.readTime}</span>
        </div>
        
        <h1 class="text-3xl md:text-4xl font-bold mb-6 leading-tight">
          {content.title}
        </h1>
        
        <p class="text-lg text-gray-600 leading-relaxed">
          {content.metaDescription}
        </p>
      </header>

      <!-- Article Content -->
      <article class="prose prose-lg max-w-none">
        <!-- Introduction -->
        <section class="mb-8">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            {content.introduction}
          </p>
          <p class="text-lg text-gray-600 leading-relaxed">
            {content.introParagraph}
          </p>
        </section>

        <!-- From Logos to Logic -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6">{content.fromLogosToLogic}</h2>
          <p class="text-lg text-gray-600 mb-4">{content.logosDescription}</p>
          
          <ul class="space-y-3 mb-6">
            {content.logosQuestions.map(question => (
              <li class="flex items-start">
                <span class="w-2 h-2 bg-blue-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                <span class="text-gray-700">{question}</span>
              </li>
            ))}
          </ul>
          
          <p class="text-lg text-gray-600 mb-4">{content.sameQuestions}</p>
          
          <ul class="space-y-3 mb-6">
            {content.devQuestions.map(question => (
              <li class="flex items-start">
                <span class="w-2 h-2 bg-green-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                <span class="text-gray-700">{question}</span>
              </li>
            ))}
          </ul>
          
          <p class="text-lg text-gray-600 font-medium">
            {content.mindsetTranslation}
          </p>
        </section>

        <!-- What is Design Thinking -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6">{content.whatIsDesignThinking}</h2>
          <p class="text-lg text-gray-600 mb-4">{content.designThinkingDef}</p>
          
          <p class="text-lg text-gray-700 mb-4 font-medium">{content.corePillars}</p>
          
          <ul class="space-y-3 mb-6">
            {content.pillars.map(pillar => (
              <li class="flex items-start">
                <span class="w-2 h-2 bg-purple-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                <span class="text-gray-700">{pillar}</span>
              </li>
            ))}
          </ul>
          
          <p class="text-lg text-gray-600 font-medium">
            {content.appliedToCode}
          </p>
        </section>

        <!-- How Design Shapes Code -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6">{content.howDesignShapesCode}</h2>
          
          <!-- Attention to Detail -->
          <div class="mb-8">
            <h3 class="text-xl font-semibold mb-4">{content.attentionToDetail}</h3>
            <p class="text-gray-700">{content.detailDescription}</p>
          </div>

          <!-- User-Centered Development -->
          <div class="mb-8">
            <h3 class="text-xl font-semibold mb-4">{content.userCenteredDev}</h3>
            <p class="text-gray-700 mb-4">{content.userCenteredDesc}</p>
            
            <ul class="space-y-2">
              {content.userQuestions.map(question => (
                <li class="flex items-start">
                  <span class="w-2 h-2 bg-orange-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                  <span class="text-gray-700">{question}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Visual Thinking -->
          <div class="mb-8">
            <h3 class="text-xl font-semibold mb-4">{content.visualThinking}</h3>
            <p class="text-gray-700">{content.visualThinkingDesc}</p>
          </div>

          <!-- Creativity Meets Problem-Solving -->
          <div class="mb-8">
            <h3 class="text-xl font-semibold mb-4">{content.creativityMeetsProblem}</h3>
            <p class="text-gray-700">{content.creativityDesc}</p>
          </div>
        </section>

        <!-- Practical Example -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6">{content.practicalExample}</h2>
          <p class="text-gray-700 mb-4">{content.exampleIntro}</p>
          
          <p class="text-lg text-gray-700 mb-4 font-medium">{content.withDesignThinking}</p>
          
          <ul class="space-y-3 mb-6">
            {content.exampleSteps.map(step => (
              <li class="flex items-start">
                <span class="w-2 h-2 bg-cyan-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                <span class="text-gray-700">{step}</span>
              </li>
            ))}
          </ul>
          
          <div class="bg-blue-50 border-l-4 border-blue-400 p-4 rounded">
            <p class="text-blue-800 font-medium">{content.exampleResult}</p>
          </div>
        </section>

        <!-- Lessons for Developers -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6">{content.lessonsForDevelopers}</h2>
          
          <ul class="space-y-3">
            {content.lessons.map(lesson => (
              <li class="flex items-start">
                <span class="w-2 h-2 bg-red-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                <span class="text-gray-700">{lesson}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Conclusion -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6">{content.conclusion}</h2>
          <p class="text-lg text-gray-700 mb-6">{content.conclusionText}</p>
          <p class="text-lg text-gray-700 font-medium">{content.finalCall}</p>
        </section>
      </article>

      <!-- Share Section -->
      <section class="border-t pt-8 mt-12">
        <div class="text-center">
          <h3 class="text-lg font-semibold mb-4">{content.shareArticle}</h3>
          <div class="flex justify-center gap-4">
            <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(content.title)}&url=${encodeURIComponent(canonical)}`} 
               target="_blank" 
               rel="noopener noreferrer"
               class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors">
              Twitter
            </a>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`} 
               target="_blank" 
               rel="noopener noreferrer"
               class="px-4 py-2 bg-blue-700 text-white rounded-lg hover:bg-blue-800 transition-colors">
              LinkedIn
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
  
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": content.title,
    "description": content.metaDescription,
    "image": "https://www.oussematrabelsi.com/images/oussema-trabelsi-cto.png",
    "author": {
      "@type": "Person",
      "name": personalInfo.name,
      "url": "https://www.oussematrabelsi.com",
      "sameAs": [
        "https://www.linkedin.com/in/oussematrabelsi",
        "https://github.com/oussematrabelsi"
      ]
    },
    "publisher": {
      "@type": "Person",
      "name": personalInfo.name,
      "url": "https://www.oussematrabelsi.com"
    },
    "datePublished": `${content.date}T00:00:00+01:00`,
    "dateModified": `${content.date}T00:00:00+01:00`,
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonical
    },
    "url": canonical,
    "articleSection": content.category,
    "wordCount": "2200",
    "timeRequired": `PT${content.readTime}M`,
    "inLanguage": lang,
    "keywords": ["Design Thinking", "Leadership", "Development", "CTO", "Creative Process", "Problem Solving"],
    "about": {
      "@type": "Thing",
      "name": "Design Thinking for Developers"
    }
  })} />
</Layout>
