---
import Layout from '../../../layouts/Layout.astro';
import { getPersonalInfo } from '../../../data/index.js';
import { languages } from '../../../types/index.js';

export async function getStaticPaths() {
  return languages.map(lang => ({
    params: { lang: lang.code }
  }));
}

const lang = Astro.params.lang || 'en';
const personalInfo = getPersonalInfo(lang);
const currentPath = `/${lang}/blog/design-thinking-for-developers`;
const currentLang = lang;
const canonical = `https://www.oussematrabelsi.com/${lang}/blog/design-thinking-for-developers`;
const title = `Design Thinking for Developers: How My Logo-Making Past Shapes My Code - ${personalInfo.name}`;
const description = `Discover how design thinking principles, learned through logo creation and visual design, can shape better developers. A personal journey from creative design to coding and CTO leadership.`;

