import { languages } from '../../../types/index.js';

export async function getStaticPaths() {
  return languages.map(lang => ({
    params: { lang: lang.code }
  }));
}

const lang = Astro.params.lang || 'en';
const personalInfo = getPersonalInfo(lang);
const currentPath = `/${lang}/blog/why-we-still-love-php-in-2025`;
const currentLang = lang;
const canonical = `https://www.oussematrabelsi.com/${lang}/blog/why-we-still-love-php-in-2025`;
const title = `Why We Still Love PHP in 2025: A Personal Perspective - ${personalInfo.name}`;
const description = `Every year, someone predicts the death of PHP. And every year, PHP just shrugs, updates itself, and keeps powering a huge portion of the internet. A personal perspective on why PHP remains relevant in 2025.`;

