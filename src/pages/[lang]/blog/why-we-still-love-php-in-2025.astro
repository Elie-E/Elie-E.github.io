        <!-- The Joke -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6">{content.theJoke}</h2>
          <p class="text-lg text-gray-600 mb-4">{content.funnyThing}</p>
          <p class="text-lg text-gray-600 mb-6">{content.honestly}</p>
          
          <div class="bg-gray-100 border-l-4 border-gray-400 p-4 rounded mb-4">
            <p class="text-gray-800 font-medium text-lg mb-2">
              {content.goodbyeWorld}
