const content = articleContent[lang as keyof typeof articleContent] || articleContent.en;
---

<Layout 
  title={title}
  description={description}
  canonical={canonical}
  currentPath={currentPath}
  currentLang={currentLang}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <!-- Back to Blog -->
      <div class="mb-8">
        <a href={`/${lang}/blog/`} class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 font-medium">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          {content.backToBlog}
        </a>
      </div>

      <!-- Article Header -->
      <header class="mb-12">
        <div class="flex items-center gap-2 mb-4">
          <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm">
            {content.category}
          </span>
          <span class="text-sm text-gray-600">{content.publishedOn} 2024-01-30</span>
          <span class="text-sm text-gray-600">*</span>
          <span class="text-sm text-gray-600">{content.readTime}</span>
        </div>
        
        <h1 class="text-3xl md:text-4xl font-bold mb-6 leading-tight">
          {content.title}
        </h1>
        
        <p class="text-lg text-gray-600 leading-relaxed">
          {content.metaDescription}
        </p>
      </header>

      <!-- Article Content -->
      <article class="prose prose-lg max-w-none">
        <!-- Introduction -->
        <section class="mb-8">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            {content.introduction}
          </p>
          <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded mb-6">
            <p class="text-yellow-800 font-medium text-lg">
              👉 {content.question}
            </p>
          </div>
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            {content.answer}
          </p>
          <p class="text-lg text-gray-600 leading-relaxed">
            {content.diveInto}
          </p>
        </section>

        <!-- PHP Powers the Web -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6">{content.phpPowersWeb}</h2>
          <p class="text-lg text-gray-600 mb-4">{content.webEcosystem}</p>
          <p class="text-lg text-gray-600 font-medium">
            {content.loveToHate}
          </p>
        </section>

        <!-- Modern PHP -->
