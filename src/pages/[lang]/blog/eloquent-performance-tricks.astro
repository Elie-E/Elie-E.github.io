    },
    "datePublished": `${content.date}T00:00:00+01:00`,
    "dateModified": `${content.date}T00:00:00+01:00`,
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonical
    },
    "url": canonical,
    "articleSection": content.category,
    "wordCount": "2500",
    "timeRequired": `PT${content.readTime}M`,
    "inLanguage": lang,
    "keywords": ["Laravel", "Eloquent", "Performance", "PHP", "Database", "Optimization", "Web Development"],
    "about": {
      "@type": "Thing",
      "name": "Laravel Eloquent Performance Optimization"
    }
  })} />
</Layout>
