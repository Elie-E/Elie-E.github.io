          {content.shareArticle}
        </a>
        <a
          href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(canonical)}&title=${encodeURIComponent(content.title)}&summary=${encodeURIComponent(content.metaDescription)}&source=${encodeURIComponent('Oussema Trabelsi Portfolio')}`}
          target="_blank"
