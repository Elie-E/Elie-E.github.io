    }
  ],
  en: [
    {
      title: "Advercity - Full Stack Development",
      description: "Building efficient web applications and improving existing sites. Database management, problem-solving, and deployment on AWS with Docker.",
      technologies: ["Laravel", "PHP", "jQuery", "Python", "HTML/SASS", "SQL", "Docker", "AWS"],
      period: "2022 - Present",
      role: "Full Stack Developer",
      url: "https://www.advercity.fr/",
