    leadership: 'Liderazgo y Gestión',
    technicalImpact: 'Impacto Técnico',
    home: 'Inicio',
    resume: 'Currículum',
    blog: 'Blog',
    contact: 'Contacto',
    viewDetails: 'Ver Detalles',
    sourceCode: 'Código Fuente',
    technologiesUsed: 'Tecnologías Utilizadas',
