  ],
  es: [
    {
      title: "Advercity - Desarrollo Full Stack",
      description: "Construcción de aplicaciones web eficientes y mejora de sitios existentes. Gestión de bases de datos, resolución de problemas y despliegue en AWS con Docker.",
