---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getPersonalInfo } from '../../data/index.js';
import { languages } from '../../types/index.js';
import imgnoteImg from '../../assets/projects/imgnote.png';
import voyalibImg from '../../assets/projects/voyalib.png';

// Generate static paths for all languages
export async function getStaticPaths() {
  return languages.map(lang => ({
    params: { lang: lang.code }
  }));
}

// Get language from URL path
const lang = Astro.params.lang || 'en';
const personalInfo = getPersonalInfo(lang);
const currentPath = `/${lang}/portfolio`;
const currentLang = lang;
const canonical = `https://elie-e.github.io/${lang}/portfolio`;
const title = `Portfolio - ${personalInfo.name}`;
const description = `Portfolio of ${personalInfo.name}, showcasing professional projects and achievements`;

// Portfolio page translations
const portfolioTranslations = {
  fr: {
    title: 'Portfolio',
    subtitle: 'Quelques projets perso.',
    featuredProjects: 'Projets',
    technicalExpertise: 'Expertise Technique',
    frontendDev: 'Développement frontend',
    backendDev: 'Développement backend & APIs',
    backendDesc: 'PHP, Laravel, Symfony, Node.js, Fastify, APIs REST, IA',
    devopsCloud: 'Infrastructure & DevOps',
    devopsDesc: 'Docker, Linux, VPS, Cloudflare, Git, déploiement et monitoring applicatif',
    architecture: 'Architecture & conception',
    architectureDesc: 'Architecture full-stack, conception d\'interfaces interactives, internationalisation (i18n), optimisation des performances web',
    keyAchievements: 'Réalisations clés',
    designDev: 'Conception & développement',
    innovation: 'Innovation & mise en production',
    viewDetails: 'Voir le projet',
    technologiesUsed: 'Technologies',
    achievements: {
      design: [
        'Conception et développement d\'applications web complètes, de l\'idée à la mise en production',
        'Réalisation d\'interfaces interactives et d\'outils de manipulation d\'images directement dans le navigateur',
        'Développement d\'applications combinant frontend moderne, backend API et services externes',
      ],
      innovation: [
        'Intégration de l\'intelligence artificielle pour automatiser des fonctionnalités métier, notamment la génération d\'itinéraires',
        'Développement d\'applications multilingues accessibles à un public international',
        'Déploiement et exploitation de services web sur infrastructure Linux avec Docker et outils de monitoring',
      ]
    }
  },
  en: {
    title: 'Portfolio',
    subtitle: 'A few personal projects.',
    featuredProjects: 'Projects',
    technicalExpertise: 'Technical Expertise',
    frontendDev: 'Frontend Development',
    backendDev: 'Backend & APIs',
    backendDesc: 'PHP, Laravel, Symfony, Node.js, Fastify, REST APIs, AI',
    devopsCloud: 'Infrastructure & DevOps',
    devopsDesc: 'Docker, Linux, VPS, Cloudflare, Git, deployment and application monitoring',
    architecture: 'Architecture & Design',
    architectureDesc: 'Full-stack architecture, interactive UI design, internationalisation (i18n), web performance optimisation',
    keyAchievements: 'Key Achievements',
    designDev: 'Design & Development',
    innovation: 'Innovation & Shipping',
    viewDetails: 'View project',
    technologiesUsed: 'Technologies',
    achievements: {
      design: [
        'Designed and developed complete web applications from idea to production',
        'Built interactive interfaces and in-browser image manipulation tools',
        'Developed applications combining modern frontend, API backend and external services',
      ],
      innovation: [
        'Integrated AI to automate business features, including itinerary generation',
        'Built multilingual applications accessible to an international audience',
        'Deployed and operated web services on Linux infrastructure with Docker and monitoring tools',
      ]
    }
  },
  es: {
    title: 'Portafolio',
    subtitle: 'Algunos proyectos personales.',
    featuredProjects: 'Proyectos',
    technicalExpertise: 'Experiencia Técnica',
    frontendDev: 'Desarrollo Frontend',
    backendDev: 'Backend & APIs',
    backendDesc: 'PHP, Laravel, Symfony, Node.js, Fastify, APIs REST, IA',
    devopsCloud: 'Infraestructura & DevOps',
    devopsDesc: 'Docker, Linux, VPS, Cloudflare, Git, despliegue y monitorización de aplicaciones',
    architecture: 'Arquitectura & Diseño',
    architectureDesc: 'Arquitectura full-stack, diseño de interfaces interactivas, internacionalización (i18n), optimización del rendimiento web',
    keyAchievements: 'Logros Clave',
    designDev: 'Diseño & Desarrollo',
    innovation: 'Innovación & Producción',
    viewDetails: 'Ver proyecto',
    technologiesUsed: 'Tecnologías',
    achievements: {
      design: [
        'Diseño y desarrollo de aplicaciones web completas, desde la idea hasta la producción',
        'Creación de interfaces interactivas y herramientas de manipulación de imágenes en el navegador',
        'Desarrollo de aplicaciones combinando frontend moderno, backend API y servicios externos',
      ],
      innovation: [
        'Integración de inteligencia artificial para automatizar funcionalidades, como la generación de itinerarios',
        'Desarrollo de aplicaciones multilingües accesibles a un público internacional',
        'Despliegue y operación de servicios web en infraestructura Linux con Docker y herramientas de monitorización',
      ]
    }
  },
};

const t = portfolioTranslations[lang as keyof typeof portfolioTranslations] || portfolioTranslations.en;

// Portfolio project data
const projects = {
  fr: [
    {
      title: "ImgNote - Annotation de captures d'écran",
      description: "Outil en ligne pour annoter des captures d'écran et des images directement dans le navigateur : flèches, texte, formes, surlignage, flou et recadrage. Landing page en Astro et éditeur applicatif développé en Angular.",
      technologies: ["Astro", "Angular", "TypeScript", "Canvas", "Tailwind CSS"],
      url: "https://imgnote.app",
      image: imgnoteImg,
      achievements: ["Éditeur d'annotation dans le navigateur", "Landing page Astro performante", "App Angular", "Multilingue (EN/FR)"]
    },
    {
      title: "Voyalib - Planificateur de voyage assisté par IA",
      description: "Application web de planification de voyage assistée par intelligence artificielle. Frontend en Nuxt, backend en Fastify et génération d'itinéraires via l'API OpenAI.",
      technologies: ["Nuxt", "Vue.js", "Fastify", "Node.js", "OpenAI API", "TypeScript"],
      url: "https://voyalib.com",
      image: voyalibImg,
      achievements: ["Génération d'itinéraires par IA", "Frontend Nuxt", "Backend Fastify", "Intégration API OpenAI"]
    }
  ],
  en: [
    {
      title: "ImgNote - Screenshot Annotation Tool",
      description: "Online tool to annotate screenshots and images directly in the browser: arrows, text, shapes, highlight, blur and crop. Astro landing page and an editor app built with Angular.",
      technologies: ["Astro", "Angular", "TypeScript", "Canvas", "Tailwind CSS"],
      url: "https://imgnote.app",
      image: imgnoteImg,
      achievements: ["In-browser annotation editor", "Fast Astro landing page", "Angular app", "Multilingual (EN/FR)"]
    },
    {
      title: "Voyalib - AI Travel Planner",
      description: "AI-assisted travel planning web app. Nuxt frontend, Fastify backend and itinerary generation powered by the OpenAI API.",
      technologies: ["Nuxt", "Vue.js", "Fastify", "Node.js", "OpenAI API", "TypeScript"],
      url: "https://voyalib.com",
      image: voyalibImg,
      achievements: ["AI-powered itinerary generation", "Nuxt frontend", "Fastify backend", "OpenAI API integration"]
    }
  ],
  es: [
    {
      title: "ImgNote - Anotación de capturas de pantalla",
      description: "Herramienta en línea para anotar capturas de pantalla e imágenes directamente en el navegador: flechas, texto, formas, resaltado, desenfoque y recorte. Landing page en Astro y editor de la app desarrollado en Angular.",
      technologies: ["Astro", "Angular", "TypeScript", "Canvas", "Tailwind CSS"],
      url: "https://imgnote.app",
      image: imgnoteImg,
      achievements: ["Editor de anotación en el navegador", "Landing page Astro rápida", "App Angular", "Multilingüe (EN/FR)"]
    },
    {
      title: "Voyalib - Planificador de viajes con IA",
      description: "Aplicación web de planificación de viajes asistida por inteligencia artificial. Frontend en Nuxt, backend en Fastify y generación de itinerarios mediante la API de OpenAI.",
      technologies: ["Nuxt", "Vue.js", "Fastify", "Node.js", "OpenAI API", "TypeScript"],
      url: "https://voyalib.com",
      image: voyalibImg,
      achievements: ["Generación de itinerarios con IA", "Frontend Nuxt", "Backend Fastify", "Integración API OpenAI"]
    }
  ],
};

const projectData = projects[lang as keyof typeof projects] || projects.en;

// Simple Icons slugs — https://simpleicons.org
const techIcons: Record<string, { slug: string; color: string }> = {
  'Angular':      { slug: 'angular',       color: '#DD0031' },
  'Vue.js':       { slug: 'vuedotjs',      color: '#4FC08D' },
  'Nuxt':         { slug: 'nuxtdotjs',     color: '#00DC82' },
  'Astro':        { slug: 'astro',         color: '#FF5D01' },
  'TypeScript':   { slug: 'typescript',    color: '#3178C6' },
  'Tailwind CSS': { slug: 'tailwindcss',   color: '#06B6D4' },
  'Tailwind':     { slug: 'tailwindcss',   color: '#06B6D4' },
  'Canvas API':   { slug: 'html5',         color: '#E34F26' },
  'Node.js':      { slug: 'nodedotjs',     color: '#5FA04E' },
  'Fastify':      { slug: 'fastify',       color: '#000000' },
  'PHP':          { slug: 'php',           color: '#777BB4' },
  'Laravel':      { slug: 'laravel',       color: '#FF2D20' },
  'Symfony':      { slug: 'symfony',       color: '#000000' },
  'OpenAI API':   { slug: 'openai',        color: '#412991' },
  'Docker':       { slug: 'docker',        color: '#2496ED' },
  'Linux':        { slug: 'linux',         color: '#FCC624' },
  'Git':          { slug: 'git',           color: '#F05032' },
  'Cloudflare':   { slug: 'cloudflare',    color: '#F38020' },
  'VPS':          { slug: 'linux',         color: '#FCC624' },
  'AWS':          { slug: 'amazonwebservices', color: '#FF9900' },
  'JavaScript':   { slug: 'javascript',    color: '#F7DF1E' },
};

async function fetchSvg(slug: string): Promise<string> {
  try {
    const res = await fetch(`https://cdn.jsdelivr.net/npm/simple-icons@v13/icons/${slug}.svg`);
    if (!res.ok) return '';
    return await res.text();
  } catch {
    return '';
  }
}

// Pre-fetch all needed SVGs at build time
const uniqueSlugs = [...new Set(Object.values(techIcons).map(v => v.slug))];
const svgCache: Record<string, string> = {};
await Promise.all(uniqueSlugs.map(async slug => {
  svgCache[slug] = await fetchSvg(slug);
}));

function techBadgeSvg(tech: string): string {
  const icon = techIcons[tech];
  if (!icon) return '';
  const raw = svgCache[icon.slug] || '';
  if (!raw) return '';
  // inject width, height and fill color directly on the <svg> tag
  return raw.replace('<svg ', `<svg width="14" height="14" fill="${icon.color}" `);
}

// Expertise sections with their tech list
const expertiseSections = [
  { key: 'frontendDev',  techs: ['Angular', 'Vue.js', 'Nuxt', 'Astro', 'TypeScript', 'Tailwind CSS', 'JavaScript'] },
  { key: 'backendDev',   techs: ['PHP', 'Laravel', 'Symfony', 'Node.js', 'Fastify', 'OpenAI API'] },
  { key: 'devopsCloud',  techs: ['Docker', 'Linux', 'Cloudflare', 'Git', 'AWS'] },
  { key: 'architecture', techs: [] },
] as const;
---

<Layout 
  title={title}
  description={description}
  canonical={canonical}
  currentPath={currentPath}
  currentLang={currentLang}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-bold mb-4">{t.title}</h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          {t.subtitle}
        </p>
      </div>

      <!-- Featured Projects -->
      <section class="mb-12">
        <h2 class="text-2xl font-semibold mb-8">{t.featuredProjects}</h2>
        <div class="grid md:grid-cols-2 gap-8">
          {projectData.map(project => (
            <div class="rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 bg-white overflow-hidden">
              {project.image && (
                <a href={project.url} target="_blank" rel="noopener noreferrer" class="block">
                  <Image
                    src={project.image}
                    alt={project.title}
                    class="w-full aspect-video object-cover object-top"
                    widths={[640, 1280]}
                    sizes="(max-width: 768px) 100vw, 50vw"
                  />
                </a>
              )}
              <div class="p-6">
              <div class="mb-4">
                <h3 class="text-xl font-semibold mb-2">{project.title}</h3>
              </div>
              
              <p class="text-gray-700 mb-4 leading-relaxed">
                {project.description}
              </p>
              
              {project.achievements && (
                <div class="mb-4">
                  <h4 class="text-sm font-semibold mb-2">{t.keyAchievements}:</h4>
                  <ul class="text-sm text-gray-600 space-y-1">
                    {project.achievements.map(achievement => (
                      <li class="flex items-center">
                        <span class="w-1.5 h-1.5 rounded-full mr-2 bg-green-500"></span>
                        {achievement}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              
              <div class="mb-4">
                <h4 class="text-sm font-semibold mb-2">{t.technologiesUsed}:</h4>
                <div class="flex flex-wrap gap-2">
                  {project.technologies.map(tech => (
                    <span class="flex items-center gap-1.5 px-2 py-1 text-xs rounded bg-gray-100 text-gray-700 font-medium">
                      <span class="inline-block w-3.5 h-3.5 shrink-0" set:html={techBadgeSvg(tech)} />
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
              
              <div class="flex gap-2">
                {project.url && (
                  <a href={project.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-4 py-2 text-sm font-semibold text-white rounded-xl bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-700 hover:to-cyan-700 shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-300">
                    {t.viewDetails}
                  </a>
                )}
              </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Technical Expertise -->
      <section class="mb-12">
        <h2 class="text-2xl font-semibold mb-8">{t.technicalExpertise}</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {expertiseSections.map(section => (
            <div class="bg-gray-50 p-6 rounded-lg">
              <h3 class="font-semibold mb-3">{t[section.key]}</h3>
              {section.techs.length > 0 ? (
                <div class="flex flex-wrap gap-2">
                  {section.techs.map(tech => (
                    <span class="flex items-center gap-1.5 px-2 py-1 text-xs rounded bg-white border border-gray-200 text-gray-700 font-medium">
                      <span class="inline-block w-3.5 h-3.5 shrink-0" set:html={techBadgeSvg(tech)} />
                      {tech}
                    </span>
                  ))}
                </div>
              ) : (
                <p class="text-sm text-gray-600">{t[section.key + 'Desc' as keyof typeof t]}</p>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Achievements -->
      <section class="mb-12">
        <h2 class="text-2xl font-semibold mb-8">{t.keyAchievements}</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-gradient-to-r from-blue-50 to-purple-50 p-6 rounded-lg">
            <h3 class="text-lg font-semibold mb-3">{t.designDev}</h3>
            <ul class="space-y-2 text-gray-700 text-sm">
              {t.achievements.design.map((item: string) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-blue-500 shrink-0"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-gradient-to-r from-green-50 to-blue-50 p-6 rounded-lg">
            <h3 class="text-lg font-semibold mb-3">{t.innovation}</h3>
            <ul class="space-y-2 text-gray-700 text-sm">
              {t.achievements.innovation.map((item: string) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-green-500 shrink-0"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

    </div>
  </main>
  
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": t.title,
    "description": t.subtitle,
    "url": canonical,
    "mainEntity": {
      "@type": "Person",
      "name": personalInfo.name,
      "jobTitle": personalInfo.title,
      "description": personalInfo.bio,
      "url": "https://elie-e.github.io",
      "image": "https://elie-e.github.io/images/og-image.png",
      "sameAs": [
        "https://linkedin.com/in/alban-augier-a64297108/",
        "https://github.com/Elie-E"
      ],
      "worksFor": {
        "@type": "Organization",
        "name": "Advercity",
        "url": "https://advercity.com"
      },
      "hasOccupation": {
        "@type": "Occupation",
        "name": "CTO & Lead Developer",
        "occupationLocation": {
          "@type": "City",
          "name": "Lyon, France"
        },
        "skills": [
          "PHP", "Laravel", "JavaScript", "React", "Node.js", "Docker", 
          "Web Development", "Leadership", "Team Management"
        ]
      }
    },
    "inLanguage": lang
  })} />
</Layout>