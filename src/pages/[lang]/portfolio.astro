      technologies: ["WordPress", "PHP", "MySQL", "WooCommerce", "CSS/JS"],
      period: "2011 - الحاضر",
      role: "مطور & صيانة",
      url: "https://elkhomssa.com/",
      achievements: ["موقع مستقر منذ 2011", "مبيعات يومية", "عملاء متكررين", "صيانة مستمرة"]
    },
    {
      title: "Freelancer.com - التصميم والإبداع",
      description: "أكثر من 10 سنوات من الخبرة في العمل الحر مع مشاريع التصميم الجرافيكي والشعارات والإبداعات البصرية. هذه التجربة طورت رؤيتي لتصميم الويب والإبداع التقني.",
      technologies: ["Photoshop", "Illustrator", "التصميم الجرافيكي", "تصميم الشعارات"],
      period: "2011 - 2021",
      role: "مصمم جرافيكي & مطور",
      url: "https://www.fr.freelancer.com/u/trcoolmec",
      achievements: ["مشاريع دولية", "تصميم إبداعي", "رؤية تصميم الويب", "تجربة العميل"]
    },
    {
      title: "ANDRICE - إعادة تصميم ERP",
      description: "هجرة كاملة لنظام ERP الداخلي من Java إلى Java JEE و Spring Boot. تحسين عمليات توليد العقود وعروض العملاء لتحسين الكفاءة التشغيلية.",
      technologies: ["Java", "Java JEE", "Spring Boot", "ERP", "الهجرة"],
      period: "2019 - 2020",
      role: "مطور Backend",
      url: "https://andricegroup.com/",
      achievements: ["هجرة Java كاملة", "تحسين ERP", "توليد العقود", "تحسين العمليات"]
    },
    {
      title: "SCIT Export - إعادة تصميم & هجرة",
      description: "إعادة تصميم كاملة وهجرة موقع PHP قديم إلى WordPress لـ SCIT (Société du Commerce International de Tunisie). هجرة البيانات، تحسين SEO، وإنشاء واجهة حديثة متعددة اللغات (الفرنسية، الإنجليزية، البرتغالية) لهذه الشركة الرائدة في التجارة الدولية التونسية منذ 1984.",
      technologies: ["WordPress", "PHP", "MySQL", "CSS/JS", "SEO", "الهجرة"],
      period: "2023 - 2024",
      role: "مطور & مستشار",
      url: "https://scit-export.com/",
      achievements: ["هجرة PHP إلى WordPress", "موقع متعدد اللغات", "تحسين SEO", "واجهة حديثة"]
    },
    {
      title: "100+ مشروع & أكثر...",
      description: "على مر السنين، كان لدي متعة العمل على أكثر من مائة مشروع متنوع! من المواقع المؤسسية إلى التطبيقات المحمولة، ومنصات التجارة الإلكترونية إلى الأدوات الداخلية، كل مشروع كان مغامرة تقنية وإبداعية جديدة.",
      technologies: ["التنوع", "المرونة", "الابتكار", "الإبداع"],
      period: "2011 - الحاضر",
      role: "مطور متعدد المهارات",
      achievements: ["100+ مشروع مكتمل", "خبرة متنوعة", "تقنيات متعددة", "حلول مخصصة"]
    }
  ]
};

const projectData = projects[lang as keyof typeof projects] || projects.en;
---

<Layout 
  title={title}
  description={description}
  canonical={canonical}
  currentPath={currentPath}
  currentLang={currentLang}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-bold mb-4">{t.title}</h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          {t.subtitle}
        </p>
      </div>

      <!-- Featured Projects -->
      <section class="mb-12">
        <h2 class="text-2xl font-semibold mb-8">{t.featuredProjects}</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {projectData.map(project => (
            <div class={`rounded-lg shadow-lg p-6 hover:shadow-xl transition-all duration-300 ${
              project.title.includes('100+') 
                ? 'bg-gradient-to-br from-purple-50 to-pink-50 border-2 border-purple-200 hover:border-purple-300 hover:scale-105' 
                : 'bg-white'
            }`}>
              <div class="mb-4">
                <h3 class={`text-xl font-semibold mb-2 ${
                  project.title.includes('100+') ? 'text-purple-800' : ''
                }`}>{project.title}</h3>
                <p class="text-sm text-gray-600 mb-2">{project.period}</p>
                <p class={`text-sm font-medium ${
                  project.title.includes('100+') ? 'text-purple-600' : 'text-blue-600'
                }`}>{project.role}</p>
              </div>
              
              <p class="text-gray-700 mb-4 leading-relaxed">
                {project.description}
              </p>
              
              {project.achievements && (
                <div class="mb-4">
                  <h4 class="text-sm font-semibold mb-2">Réalisations clés:</h4>
                  <ul class="text-sm text-gray-600 space-y-1">
                    {project.achievements.map(achievement => (
                      <li class="flex items-center">
                        <span class={`w-1.5 h-1.5 rounded-full mr-2 ${
                          project.title.includes('100+') ? 'bg-purple-500' : 'bg-green-500'
                        }`}></span>
                        {achievement}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              
              <div class="mb-4">
                <h4 class="text-sm font-semibold mb-2">{t.technologiesUsed}:</h4>
                <div class="flex flex-wrap gap-2">
                  {project.technologies.map(tech => (
                    <span class={`px-2 py-1 text-xs rounded ${
                      project.title.includes('100+') 
                        ? 'bg-purple-100 text-purple-800 border border-purple-200' 
                        : 'bg-blue-100 text-blue-800'
                    }`}>
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
              
              <div class="flex gap-2">
                {project.url && (
                  <a href={project.url} target="_blank" rel="noopener noreferrer" class={`px-4 py-2 text-white rounded hover:transition-colors text-sm ${
                    project.title.includes('100+') 
                      ? 'bg-purple-600 hover:bg-purple-700' 
                      : 'bg-blue-600 hover:bg-blue-700'
                  }`}>
                    Voir le projet
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Technical Skills -->
      <section class="mb-12">
        <h2 class="text-2xl font-semibold mb-8">{t.technicalExpertise}</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-gray-50 p-6 rounded-lg text-center">
            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 11-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <h3 class="font-semibold mb-2">{t.frontendDev}</h3>
            <p class="text-sm text-gray-600">React, Vue.js, Angular, TypeScript, Tailwind CSS</p>
          </div>
          
          <div class="bg-gray-50 p-6 rounded-lg text-center">
            <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <h3 class="font-semibold mb-2">{t.backendDev}</h3>
            <p class="text-sm text-gray-600">Node.js, PHP, Laravel, Python, REST APIs</p>
          </div>
          
          <div class="bg-gray-50 p-6 rounded-lg text-center">
            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3 3a1 1 0 000 2v8a2 2 0 002 2h2.586l-1.293 1.293a1 1 0 101.414 1.414L10 15.414l2.293 2.293a1 1 0 001.414-1.414L12.414 15H15a2 2 0 002-2V5a1 1 0 100-2H3zm11.707 4.707a1 1 0 00-1.414-1.414L10 9.586 8.707 8.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <h3 class="font-semibold mb-2">{t.databaseMgmt}</h3>
            <p class="text-sm text-gray-600">MySQL, MongoDB, PostgreSQL, Redis</p>
          </div>
          
          <div class="bg-gray-50 p-6 rounded-lg text-center">
            <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-orange-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <h3 class="font-semibold mb-2">{t.devopsCloud}</h3>
            <p class="text-sm text-gray-600">AWS, Docker, CI/CD, Linux, Git</p>
          </div>
        </div>
      </section>

      <!-- Achievements -->
      <section class="mb-12">
        <h2 class="text-2xl font-semibold mb-8">{t.keyAchievements}</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-gradient-to-r from-blue-50 to-purple-50 p-6 rounded-lg">
            <h3 class="text-lg font-semibold mb-3">{t.leadership}</h3>
            <ul class="space-y-2 text-gray-700">
              {t.achievements.leadership.map(achievement => (
                <li>* {achievement}</li>
              ))}
            </ul>
          </div>
          
          <div class="bg-gradient-to-r from-green-50 to-blue-50 p-6 rounded-lg">
            <h3 class="text-lg font-semibold mb-3">{t.technicalImpact}</h3>
            <ul class="space-y-2 text-gray-700">
              {t.achievements.technical.map(achievement => (
                <li>* {achievement}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>

    </div>
  </main>
  
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": t.title,
    "description": t.subtitle,
    "url": canonical,
    "mainEntity": {
      "@type": "Person",
      "name": personalInfo.name,
      "jobTitle": personalInfo.title,
      "description": personalInfo.bio,
      "url": "https://www.oussematrabelsi.com",
      "image": "https://www.oussematrabelsi.com/images/oussema-trabelsi-cto.png",
      "sameAs": [
        "https://www.linkedin.com/in/oussematrabelsi",
        "https://github.com/oussematrabelsi"
      ],
      "worksFor": {
        "@type": "Organization",
        "name": "Advercity",
        "url": "https://advercity.com"
      },
      "hasOccupation": {
        "@type": "Occupation",
        "name": "CTO & Lead Developer",
        "occupationLocation": {
          "@type": "City",
          "name": "Lyon, France"
        },
        "skills": [
          "PHP", "Laravel", "JavaScript", "React", "Node.js", "Docker", 
          "Web Development", "Leadership", "Team Management"
        ]
      }
    },
    "inLanguage": lang
  })} />
</Layout>