---
import Layout from '../../layouts/Layout.astro';
import { getPersonalInfo } from '../../data/index.js';
import { languages } from '../../types/index.js';

// Generate static paths for all languages
export async function getStaticPaths() {
  return languages.map(lang => ({
    params: { lang: lang.code }
  }));
}

// Get language from URL path
const lang = Astro.params.lang || 'en';
const personalInfo = getPersonalInfo(lang);
const currentPath = `/${lang}/portfolio`;
const currentLang = lang;
const canonical = `https://elie-e.github.io/${lang}/portfolio`;
const title = `Portfolio - ${personalInfo.name}`;
const description = `Portfolio of ${personalInfo.name}, showcasing professional projects and achievements`;

// Portfolio page translations
const portfolioTranslations = {
