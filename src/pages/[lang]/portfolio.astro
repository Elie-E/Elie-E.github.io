const t = portfolioTranslations[lang as keyof typeof portfolioTranslations] || portfolioTranslations.en;

// Portfolio project data
const projects = {
  fr: [
    {
      title: "Advercity - Développement Full Stack",
      description: "Construction d'applications web efficaces et amélioration de sites existants. Gestion des bases de données, résolution de problèmes et déploiement sur AWS avec Docker.",
      technologies: ["Laravel", "PHP", "jQuery", "Python", "HTML/SASS", "SQL", "Docker", "AWS"],
      period: "2022 - Présent",
      role: "Développeur Full Stack",
      url: "https://www.advercity.fr/",
      achievements: ["Applications web optimisées", "Déploiement Docker/AWS", "Amélioration BDD", "Performances accrues"]
    },
    {
      title: "Nateev - Gestion de Projets E-Commerce",
      description: "Chef de projet e-commerce et développeur front-end. Coordination de projets de la conception à la livraison, avec une équipe pluridisciplinaire.",
      technologies: ["JavaScript", "CodeIgniter", "HTML/SASS", "SEO", "Analytics"],
      period: "2021 - 2022",
