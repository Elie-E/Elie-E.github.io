    }
  },
  es: {
    title: 'Portafolio',
    subtitle: 'Una vitrina de mis proyectos profesionales, logros técnicos y contribuciones a la comunidad de desarrollo.',
    featuredProjects: 'Proyectos Destacados',
    technicalExpertise: 'Experiencia Técnica',
    frontendDev: 'Desarrollo Frontend',
    backendDev: 'Desarrollo Backend',
    databaseMgmt: 'Gestión de Base de Datos',
    devopsCloud: 'DevOps y Cloud',
