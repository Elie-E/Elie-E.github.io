    },
    {
      title: "Nateev - E-Commerce Project Management",
      description: "E-commerce project manager and front-end developer. Coordinating projects from conception to delivery with a multidisciplinary team.",
      technologies: ["JavaScript", "CodeIgniter", "HTML/SASS", "SEO", "Analytics"],
      period: "2021 - 2022",
      role: "Project Manager & Front End Developer",
      achievements: ["Multi-project management", "On-time delivery", "Team coordination", "Season Paper project"]
    },
    {
      title: "El Viaje - Mexico",
      description: "Created and managed a Mexican restaurant from scratch. Designed concept, visual identity, and menu. Team management and customer satisfaction.",
      technologies: [],
