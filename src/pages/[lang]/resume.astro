---
import Layout from '../../layouts/Layout.astro';
import { getPersonalInfo, getExperiences, getEducation, formatDate } from '../../data';
import { languages } from '../../types';

export async function getStaticPaths() {
  return languages.map(lang => ({
    params: { lang: lang.code }
  }));
}

const lang = Astro.params.lang || 'en';
const personalInfo = getPersonalInfo(lang);
const experiences = getExperiences(lang);
const education = getEducation(lang);

const currentPath = `/${lang}/resume`;
const currentLang = lang;
const canonical = `https://elie-e.github.io/${lang}/resume`;

// Resume page translations
const resumeTranslations = {
  fr: {
    title: 'CV',
    subtitle: 'Expérience Professionnelle & Formation',
    personalInfo: 'Informations Personnelles',
    name: 'Nom',
    title_label: 'Titre',
    location: 'Localisation',
    email: 'Email',
    linkedin: 'LinkedIn',
    website: 'Site Web',
    profile: 'Profil',
    portfolio: 'Portfolio',
    summary: 'Résumé Professionnel',
    experience: 'Expérience Professionnelle',
    education: 'Formation',
    skills: 'Compétences & Langues',
    languages: 'Langues',
    certifications: 'Certifications',
    downloadCV: 'Télécharger mon CV',
    home: 'Accueil',
    blog: 'Blog',
    contact: 'Contact',
    years: 'ans',
    age: 'Âge',
    present: 'Présent',
    months: 'mois',
    days: 'jours',
    hours: 'heures',
    minutes: 'minutes',
    seconds: 'secondes'
  },
  en: {
    title: 'Resume',
    subtitle: 'Professional Experience & Education',
    personalInfo: 'Personal Information',
    name: 'Name',
    title_label: 'Title',
    location: 'Location',
    email: 'Email',
    linkedin: 'LinkedIn',
    website: 'Website',
    profile: 'Profile',
    portfolio: 'Portfolio',
    summary: 'Professional Summary',
    experience: 'Professional Experience',
    education: 'Education',
    skills: 'Skills & Languages',
    languages: 'Languages',
    certifications: 'Certifications',
    downloadCV: 'Download my CV',
    home: 'Home',
    blog: 'Blog',
    contact: 'Contact',
    years: 'years',
    age: 'Age',
    present: 'Present',
    months: 'months',
    days: 'days',
    hours: 'hours',
    minutes: 'minutes',
    seconds: 'seconds'
  },
  es: {
    title: 'Currículum',
    subtitle: 'Experiencia Profesional y Educación',
    personalInfo: 'Información Personal',
    name: 'Nombre',
    title_label: 'Título',
    location: 'Ubicación',
    email: 'Email',
    linkedin: 'LinkedIn',
    website: 'Sitio Web',
    profile: 'Perfil',
    portfolio: 'Portafolio',
    summary: 'Resumen Profesional',
    experience: 'Experiencia Profesional',
    education: 'Educación',
    skills: 'Habilidades e Idiomas',
    languages: 'Idiomas',
    certifications: 'Certificaciones',
    downloadCV: 'Descargar mi CV',
    home: 'Inicio',
    blog: 'Blog',
    contact: 'Contacto',
    years: 'años',
    age: 'Edad',
    present: 'Presente',
    months: 'meses',
    days: 'días',
    hours: 'horas',
    minutes: 'minutos',
    seconds: 'segundos'
  },
};

const t = resumeTranslations[lang as keyof typeof resumeTranslations] || resumeTranslations.en;
---

<Layout 
  title={`${t.title} - ${personalInfo.name}`}
  description={personalInfo.bio}
  canonical={canonical}
  currentPath={currentPath}
  currentLang={currentLang}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-8">
        <h1 class="text-3xl md:text-4xl font-bold mb-2">{t.title}</h1>
        <p class="text-gray-600">{t.subtitle}</p>
      </div>

      <!-- Personal Info -->
      <section class="bg-gray-100 p-6 rounded-lg mb-8">
        <!-- <h2 class="text-2xl font-semibold mb-4">{t.personalInfo}</h2> -->
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <p><strong>{t.name}:</strong> {personalInfo.name}</p>
            <p><strong>{t.title_label}:</strong> {personalInfo.title}</p>
            <p><strong>{t.location}:</strong> {personalInfo.location}</p>
          </div>
          <div>
                  <p><strong>{t.experience}:</strong> 4 {t.years}</p>
          </div>
        </div>
      </section>

      <!-- Professional Summary -->
      <section class="mb-8">
        <h2 class="text-2xl font-semibold mb-4">{t.summary}</h2>
        <p class="text-gray-700 leading-relaxed mb-6">
          {personalInfo.bio}
        </p>
        <!-- Download PDF Button -->
        <div class="flex justify-center no-print">
          <button
            id="download-pdf-btn"
            onclick="window.print()"
            class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg shadow transition-colors duration-200 cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V4" />
            </svg>
            {t.downloadCV}
          </button>
        </div>
      </section>

      <!-- Experience -->
      <section class="mb-8">
        <h2 class="text-2xl font-semibold mb-6">{t.experience}</h2>
        <div class="space-y-6">
          {experiences.map(exp => {
            const startDate = formatDate(exp.startDate, lang);
            const endDate = exp.endDate ? formatDate(exp.endDate, lang) : t.present;
            const period = `${startDate} - ${endDate}`;
            
            return (
              <div class="border-l-4 border-blue-600 pl-6">
                <div class="flex flex-col md:flex-row md:justify-between md:items-start mb-2">
                  <h3 class="text-xl font-semibold">{exp.position}</h3>
                  <span class="text-gray-600 text-sm">{period}</span>
                </div>
                <p class="text-blue-600 font-medium mb-2">{exp.company}</p>
                <p class="text-gray-600 mb-3">{exp.location}</p>
                <p class="text-gray-700 mb-3">{exp.description}</p>
                {exp.achievements && exp.achievements.length > 0 && (
                  <ul class="divide-y divide-gray-200 text-gray-700 mb-3 text-sm">
                    {exp.achievements.map(achievement => (
                      <li class="font-semibold py-1.5 flex gap-2 items-start">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-blue-400 shrink-0"></span>
                        <span>{achievement}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {exp.technologies && exp.technologies.length > 0 && (
                  <p class="text-sm text-gray-500 mt-2">
                    <span class="font-medium">Technologies :</span> {exp.technologies.join(', ')}
                  </p>
                )}
              </div>
            );
          })}
        </div>
      </section>

      <!-- Education -->
      <section class="mb-8">
        <h2 class="text-2xl font-semibold mb-6">{t.education}</h2>
        <div class="space-y-4">
          {education.map(edu => {
            const period = `${edu.startDate} - ${edu.endDate}`;
            return (
              <div class="bg-gray-100 p-4 rounded-lg">
                <div class="flex flex-col mb-2">
                  <h3 class="text-lg font-semibold">{edu.title}</h3>
                  <p>{edu.subtitle}</p>
                  {/* <span class="text-gray-600 text-sm">{period}</span> */}
                </div>
                <p class="text-blue-600 font-medium">{edu.institution}</p>
                {edu.location && <p class="text-gray-600">{edu.location}</p>}
                {edu.grade && <p class="text-gray-600">Note: {edu.grade}</p>}
              </div>
            );
          })}
        </div>
      </section>

      <!-- Skills -->
      <section class="mb-8">
        <h2 class="text-2xl font-semibold mb-6">{t.skills}</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <!-- Languages -->
          <div>
            <h3 class="text-lg font-semibold mb-4">{t.languages}</h3>
            <ul class="space-y-2">
              {personalInfo.languages.map(lang => (
                <li class="flex items-center gap-2">
                  <div class="w-2 h-2 bg-blue-600 rounded-full"></div>
                  {lang}
                </li>
              ))}
            </ul>
          </div>

          <!-- Certifications -->
          <div>
            <h3 class="text-lg font-semibold mb-4">{t.certifications}</h3>
            <ul class="space-y-2">
              {personalInfo.certifications.map(cert => (
                <li class="flex items-center gap-2">
                  <div class="w-2 h-2 bg-green-600 rounded-full"></div>
                  {cert}
                </li>
              ))}
            </ul>
          </div>
        </div>
        
      </section>

    </div>
  </main>
</Layout>

