---
import Layout from '../../layouts/Layout.astro';
import { getPersonalInfo } from '../../data/index.js';
import { languages } from '../../types/index.js';
import JourneySection from '../../components/JourneySection.astro';
import SkillsSection from '../../components/SkillsSection.astro';
import TestimonialsCarousel from '../../components/TestimonialsCarousel.astro';
import ExperienceTimeline from '../../components/ExperienceTimeline.astro';
import ContactSection from '../../components/ContactSection.astro';

// Generate static paths for all languages
export async function getStaticPaths() {
  return languages.map(lang => ({
    params: { lang: lang.code }
  }));
}

// Get language from URL path
const lang = Astro.params.lang || 'en';
const personalInfo = getPersonalInfo(lang);
const currentPath = `/${lang}`;
const currentLang = lang;
const canonical = `https://elie-e.github.io/${lang}`;
const title = `${personalInfo.name} - ${personalInfo.title}`;
const description = personalInfo.bio;

// Navigation translations
const navTranslations = {
  en: { resume: 'Resume', portfolio: 'Portfolio', blog: 'Blog', about: 'About', contact: 'Contact', services: 'Services' },
  fr: { resume: 'CV', portfolio: 'Portfolio', blog: 'Blog', about: 'À propos', contact: 'Contact', services: 'Services' },
  es: { resume: 'Currículum', portfolio: 'Portafolio', blog: 'Blog', about: 'Acerca de', contact: 'Contacto', services: 'Servicios' },
};

const nav = navTranslations[lang as keyof typeof navTranslations] || navTranslations.en;
---

<Layout 
  title={title}
  description={description}
  canonical={canonical}
  currentPath={currentPath}
  currentLang={currentLang}
>
  <main>
    <!-- Hero Section -->
    <section class="py-12 md:py-20 bg-gradient-to-br from-blue-50 via-white to-cyan-50 hero-section">
      <div class="container mx-auto px-4 md:px-6 max-w-full overflow-hidden">
        <div class="max-w-6xl mx-auto">
          <div class="grid lg:grid-cols-2 gap-6 md:gap-8 lg:gap-12 items-start lg:items-center">
            <!-- Text Content -->
            <div class="text-center lg:text-left order-2 lg:order-1 w-full max-w-full">
              <h1 class="text-2xl md:text-3xl lg:text-6xl font-bold mb-3 md:mb-4 lg:mb-6 bg-gradient-to-r from-blue-600 to-cyan-600 bg-clip-text text-transparent">
                {personalInfo.name}
              </h1>
              <h2 class="text-base md:text-lg lg:text-2xl text-gray-600 mb-4 md:mb-6 lg:mb-8">
                {personalInfo.title}
              </h2>
              <p class="text-xs md:text-sm lg:text-lg text-gray-700 max-w-full mx-auto lg:mx-0 mb-6 md:mb-8 lg:mb-12 leading-relaxed px-2 lg:px-0 text-overflow-fix">
                {personalInfo.bio}
              </p>
              
              <!-- Quick Navigation -->
              <div class="flex flex-nowrap justify-center lg:justify-start gap-1 md:gap-2 mb-8 md:mb-12 overflow-x-auto px-1 md:px-2">
                <a href={`/${lang}/resume/`} class="px-2 py-1 md:px-3 md:py-2 bg-white text-gray-700 border-2 border-gray-300 rounded-lg md:rounded-xl hover:bg-gray-50 transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl whitespace-nowrap text-xs">
                  {nav.resume}
                </a>
 
                <a href={`/${lang}/services`} class="px-2 py-1 md:px-3 md:py-2 bg-white text-cyan-600 border-2 border-cyan-200 rounded-lg md:rounded-xl hover:bg-cyan-50 hover:border-cyan-400 transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl whitespace-nowrap text-xs font-medium" style="box-shadow: 0 0 8px rgba(6,182,212,0.25);">
                  {nav.services}
                </a>
              </div>
            </div>

            <!-- Photo -->
            <div class="flex justify-center lg:justify-end order-1 lg:order-2 photo-container">
              <div class="relative group">
                <div class="w-56 h-56 md:w-72 md:h-72 lg:w-[28rem] lg:h-[28rem] rounded-2xl md:rounded-3xl overflow-hidden shadow-2xl border-4 border-blue-200 hover:border-blue-400 transition-all duration-500 hover:scale-105 hover:shadow-3xl">
                <picture>
                  <source srcset="/images/og-image.webp" type="image/webp">
                  <img 
                    src="/images/og-image.png" 
                    alt="Alban Augier - Full Stack Developer"
                    class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-110"
                    style="object-position: center 20%;"
                    loading="eager"
                    decoding="sync"
                    fetchpriority="high"
                  />
                </picture>
                </div>
                <!-- Enhanced decorative elements - positioned inside container -->
                <div class="absolute top-2 right-2 md:top-4 md:right-4 w-6 h-6 md:w-8 md:h-8 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full opacity-20 animate-pulse group-hover:opacity-40 transition-opacity duration-300 decorative-element"></div>
                <div class="absolute bottom-2 left-2 md:bottom-4 md:left-4 w-4 h-4 md:w-6 md:h-6 bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full opacity-30 animate-pulse group-hover:opacity-50 transition-opacity duration-300 decorative-element" style="animation-delay: 0.5s;"></div>
                <div class="absolute top-1/2 left-2 md:left-4 w-3 h-3 md:w-4 md:h-4 bg-gradient-to-r from-blue-400 to-purple-400 rounded-full opacity-25 animate-pulse group-hover:opacity-40 transition-opacity duration-300 decorative-element" style="animation-delay: 1s;"></div>
                <!-- Glow effect on hover -->
                <div class="absolute inset-0 rounded-2xl md:rounded-3xl bg-gradient-to-r from-blue-400/20 to-cyan-400/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- My Journey Section -->
    <JourneySection lang={lang} />

    <!-- Skills Section -->
    <SkillsSection lang={lang} />

    <!-- Experience Timeline -->
    <!-- Testimonials Carousel -->
    <TestimonialsCarousel lang={lang} />
    
    <ExperienceTimeline lang={lang} />

    <!-- Services Teaser -->
    <section class="py-12 md:py-16 bg-gradient-to-br from-gray-900 via-blue-950 to-gray-900 text-white">
      <div class="container mx-auto px-4 md:px-6 max-w-5xl">
        <div class="text-center mb-8 md:mb-10">
          <p class="text-xs uppercase tracking-widest text-blue-400 font-mono mb-2">/ services</p>
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-3">Need a dev for your project?</h2>
          <p class="text-gray-300 max-w-xl mx-auto">New website, urgent bug fix, or long-term maintenance — clear scope, no bloated agency process.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
          {[
            { label: 'New website', desc: 'Custom build, no generic theme', icon: '⚡' },
            { label: 'Debug & rescue', desc: 'Investigate & fix broken things', icon: '🔧' },
            { label: 'Maintenance', desc: 'Updates, backups, monitoring', icon: '🛡️' },
            { label: 'Evolution', desc: 'New features & UX improvements', icon: '🚀' },
          ].map(s => (
            <div class="rounded-xl border border-white/10 bg-white/5 p-4 text-sm">
              <div class="text-2xl mb-2">{s.icon}</div>
              <div class="font-semibold text-white mb-1">{s.label}</div>
              <div class="text-gray-400 text-xs">{s.desc}</div>
            </div>
          ))}
        </div>
        <div class="text-center">
          <a href={`/${lang}/services`} class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-cyan-600 text-white font-semibold rounded-xl hover:opacity-90 transition-all duration-300 hover:scale-105 shadow-lg">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
            View all services
          </a>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <ContactSection lang={lang} />
  </main>
  
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": personalInfo.name,
    "jobTitle": personalInfo.title,
    "description": personalInfo.bio,
    "url": "https://elie-e.github.io",
    "image": "https://elie-e.github.io/images/og-image.png",
    "sameAs": [
      "https://linkedin.com/in/alban-augier-a64297108/"
    ],
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "France"
    },
    "worksFor": {
      "@type": "Organization",
      "name": "Advercity"
    },
    "knowsAbout": [
      "PHP", "Laravel", "JavaScript", "React", "Python",
      "Web Development", "Project Management", "Full Stack Development"
    ]
  })} />
</Layout>
