---

<Layout 
  title={title}
  description={description}
  canonical={canonical}
  currentPath={currentPath}
  currentLang={currentLang}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-bold mb-4">{t.title}</h1>
        <p class="text-lg text-gray-600">
          {t.subtitle}
        </p>
      </div>

      <!-- Contact Information -->
      <div class="max-w-2xl mx-auto">
          <h2 class="text-2xl font-semibold mb-6">{t.getInTouch}</h2>
          
          <!-- Direct Contact -->
          <div class="space-y-6 mb-8">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                  <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold mb-1">{t.emailLabel}</h3>

                <p class="text-sm text-gray-600 mt-1">
                  {t.responseTime}
                </p>
                <p class="text-sm mt-1">
                  <a href="#email-form" class="text-blue-500 hover:underline inline-flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    {t.emailFormSection}
                  </a>
                </p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold mb-1">{t.linkedinLabel}</h3>
                <a href={personalInfo.linkedin} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
                  {t.profile}
                </a>
                <p class="text-sm text-gray-600 mt-1">
                  {t.professionalNetworking}
                </p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold mb-1">{t.locationLabel}</h3>
                <p class="text-gray-700">{personalInfo.location}</p>
                <p class="text-sm text-gray-600 mt-1">
                  {t.remoteCollaboration}
                </p>
              </div>
            </div>

            {t.languagesLabel && (
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-violet-100 rounded-lg flex items-center justify-center text-lg">
                  🌍
                </div>
                <div>
                  <h3 class="font-semibold mb-1">{t.languagesLabel}</h3>
                  <p class="text-gray-700">{t.languagesValue}</p>
                  <p class="text-sm text-gray-500 mt-1">🇫🇷 🇬🇧 🇪🇸</p>
                </div>
              </div>
            )}
          </div>

          <!-- Availability -->
          <div class="bg-gray-50 rounded-lg p-6 mb-8">
            <h3 class="font-semibold mb-4">{t.currentAvailability}</h3>
            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                <span class="text-sm">{t.openOpportunities}</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
                <span class="text-sm">{t.consultingProjects}</span>
              </div>
            </div>
          </div>

          <!-- Response Time -->
          <div class="bg-blue-50 rounded-lg p-6">
            <h3 class="font-semibold mb-2">{t.respondTime}</h3>
            <p class="text-sm text-gray-700">
              {t.respondTimeDesc}
            </p>
          </div>
      </div>

      <!-- Email Form -->
      <div id="email-form" class="max-w-2xl mx-auto mt-12 pt-10 border-t border-gray-200">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-semibold">{t.formTitle}</h2>
          <span class="text-xs font-mono uppercase tracking-widest bg-blue-50 text-blue-600 border border-blue-200 rounded-full px-3 py-1">{t.formPill}</span>
        </div>
        <form id="contactEmailForm" class="space-y-4">
          <input type="text" name="_hp" tabindex="-1" autocomplete="off" class="hidden" />
          <div>
            <label for="ef-name" class="block text-xs font-mono uppercase tracking-widest text-gray-500 mb-1">{t.formName}</label>
            <input id="ef-name" name="name" type="text" placeholder={t.formNamePh} required
              class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm text-gray-900 outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-300 transition" />
          </div>
          <div>
            <label for="ef-email" class="block text-xs font-mono uppercase tracking-widest text-gray-500 mb-1">{t.formEmail}</label>
            <input id="ef-email" name="email" type="email" placeholder={t.formEmailPh} required
              class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm text-gray-900 outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-300 transition" />
          </div>
          <div>
            <label for="ef-subject" class="block text-xs font-mono uppercase tracking-widest text-gray-500 mb-1">{t.formSubjectField}</label>
            <input id="ef-subject" name="subject" type="text" placeholder={t.formSubjectPh}
              class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm text-gray-900 outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-300 transition" />
          </div>
          <div>
            <label for="ef-message" class="block text-xs font-mono uppercase tracking-widest text-gray-500 mb-1">{t.formMessage}</label>
            <textarea id="ef-message" name="message" rows="5" placeholder={t.formMessagePh} required
              class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm text-gray-900 outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-300 transition resize-vertical"></textarea>
          </div>
          <div class="flex items-center gap-4">
            <button id="efSubmitBtn" type="submit"
              class="inline-flex items-center gap-2 rounded-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-5 py-2.5 transition focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              {t.formSend}
            </button>
            <p id="efStatus" class="text-sm font-mono hidden"></p>
          </div>
        </form>
        <script id="contact-form-i18n" type="application/json"
          data-worker-url={import.meta.env.PUBLIC_CONTACT_WORKER_URL ?? ''}
          set:html={JSON.stringify({ sending: t.formSending, success: t.formSuccess, error: t.formError })}></script>
      </div>
    </div>
  </main>

  <script>
    document.getElementById('contactEmailForm')?.addEventListener('focusin', () => {
      if (!sessionStorage.getItem('_cft')) sessionStorage.setItem('_cft', String(Date.now()));
    }, { once: true });

    document.getElementById('contactEmailForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const btn = document.getElementById('efSubmitBtn') as HTMLButtonElement | null;
      const status = document.getElementById('efStatus') as HTMLElement | null;
      const i18nEl = document.getElementById('contact-form-i18n') as (HTMLElement & { dataset: DOMStringMap }) | null;
      const i18n = JSON.parse(i18nEl?.textContent ?? '{}');
      const WORKER_URL = i18nEl?.dataset?.workerUrl ?? '';
      const data = Object.fromEntries(new FormData(form));
      if (btn) { btn.style.opacity = '0.6'; btn.style.pointerEvents = 'none'; }
      if (status) { status.textContent = i18n.sending; status.className = 'text-sm font-mono text-gray-500'; status.classList.remove('hidden'); }
      try {
        const res = await fetch(WORKER_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, _t: Number(sessionStorage.getItem('_cft') || Date.now()) })
        });
        if (!res.ok) throw new Error('Server error');
        if (status) { status.textContent = i18n.success; status.className = 'text-sm font-mono text-green-600'; }
        form.reset();
      } catch {
        if (status) { status.textContent = i18n.error; status.className = 'text-sm font-mono text-red-600'; }
      } finally {
        if (btn) { btn.style.opacity = '1'; btn.style.pointerEvents = 'auto'; }
      }
    });
  </script>
  
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": t.title,
    "description": t.subtitle,
    "url": canonical,
    "mainEntity": {
      "@type": "Person",
      "name": personalInfo.name,
      "jobTitle": personalInfo.title,
      "description": personalInfo.bio,
      "url": "https://elie-e.github.io",
      "image": "https://elie-e.github.io/images/og-image.png",
      "email": "",
      "sameAs": [
        "https://linkedin.com/in/alban-augier-a64297108/",
        "https://github.com/Elie-E"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lyon",
        "addressCountry": "France"
      },
      "worksFor": {
        "@type": "Organization",
        "name": "Advercity",
        "url": "https://advercity.com"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "",
        "contactType": "professional",
        "availableLanguage": ["French", "English", "Arabic"]
      }
    },
    "inLanguage": lang
  })} />
</Layout>