const t = contactTranslations[lang as keyof typeof contactTranslations] || contactTranslations.en;
---

<Layout 
  title={title}
  description={description}
  canonical={canonical}
  currentPath={currentPath}
  currentLang={currentLang}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-bold mb-4">{t.title}</h1>
        <p class="text-lg text-gray-600">
          {t.subtitle}
        </p>
      </div>

      <!-- Contact Information -->
      <div class="max-w-2xl mx-auto">
          <h2 class="text-2xl font-semibold mb-6">{t.getInTouch}</h2>
          
          <!-- Direct Contact -->
          <div class="space-y-6 mb-8">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                  <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold mb-1">{t.emailLabel}</h3>
                <a href={`mailto:${personalInfo.email}`} class="text-blue-600 hover:underline">
                  {personalInfo.email}
                </a>
                <p class="text-sm text-gray-600 mt-1">
                  {t.responseTime}
                </p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold mb-1">{t.linkedinLabel}</h3>
                <a href={personalInfo.linkedin} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
                  {t.profile}
                </a>
                <p class="text-sm text-gray-600 mt-1">
                  {t.professionalNetworking}
                </p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold mb-1">{t.locationLabel}</h3>
                <p class="text-gray-700">{personalInfo.location}</p>
                <p class="text-sm text-gray-600 mt-1">
                  {t.remoteCollaboration}
                </p>
              </div>
            </div>
          </div>

          <!-- Availability -->
          <div class="bg-gray-50 rounded-lg p-6 mb-8">
            <h3 class="font-semibold mb-4">{t.currentAvailability}</h3>
            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                <span class="text-sm">{t.openOpportunities}</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
                <span class="text-sm">{t.consultingProjects}</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-3 h-3 bg-blue-500 rounded-full"></div>
                <span class="text-sm">{t.speakingEngagements}</span>
              </div>
            </div>
          </div>

          <!-- Response Time -->
          <div class="bg-blue-50 rounded-lg p-6">
            <h3 class="font-semibold mb-2">{t.respondTime}</h3>
            <p class="text-sm text-gray-700">
              {t.respondTimeDesc}
            </p>
          </div>
      </div>
    </div>
  </main>
  
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": t.title,
    "description": t.subtitle,
    "url": canonical,
    "mainEntity": {
      "@type": "Person",
      "name": personalInfo.name,
      "jobTitle": personalInfo.title,
      "description": personalInfo.bio,
      "url": "https://www.oussematrabelsi.com",
      "image": "https://www.oussematrabelsi.com/images/oussema-trabelsi-cto.png",
      "email": "contact@oussematrabelsi.com",
      "sameAs": [
        "https://www.linkedin.com/in/oussematrabelsi",
        "https://github.com/oussematrabelsi"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lyon",
        "addressCountry": "France"
      },
      "worksFor": {
        "@type": "Organization",
        "name": "Advercity",
        "url": "https://advercity.com"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "contact@oussematrabelsi.com",
        "contactType": "professional",
        "availableLanguage": ["French", "English", "Arabic"]
      }
    },
    "inLanguage": lang
  })} />
</Layout>