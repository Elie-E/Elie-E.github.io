import { getPersonalInfo } from '../../data/index.js';
import { languages } from '../../types/index.js';

// Generate static paths for all languages
export async function getStaticPaths() {
  return languages.map(lang => ({
    params: { lang: lang.code }
  }));
}

// Get language from URL path
const lang = Astro.params.lang || 'en';
const personalInfo = getPersonalInfo(lang);
const currentPath = `/${lang}/contact`;
const currentLang = lang;
const canonical = `https://elie-e.github.io/${lang}/contact`;
const title = `Contact - ${personalInfo.name}`;
