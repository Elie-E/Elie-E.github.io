---

<Layout 
  title={title}
  description={description}
  canonical={canonical}
  currentPath={currentPath}
  currentLang={currentLang}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-bold mb-4">{t.title}</h1>
        <p class="text-lg text-gray-600">
          {t.subtitle}
        </p>
      </div>

      <!-- My Journey Section -->
      <JourneySection lang={lang} />

      <!-- Values & Philosophy -->
      <section class="mb-12">
        <h2 class="text-2xl font-semibold mb-8">{t.values}</h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-gradient-to-br from-blue-50 to-purple-50 p-6 rounded-lg">
            <h3 class="text-xl font-semibold mb-4">{t.technicalExcellence}</h3>
            <ul class="space-y-2 text-gray-700">
              <li>* {t.embraceLearning}</li>
              <li>* {t.prioritizeUX}</li>
              <li>* {t.buildScalable}</li>
            </ul>
          </div>
          
          <div class="bg-gradient-to-br from-green-50 to-blue-50 p-6 rounded-lg">
            <h3 class="text-xl font-semibold mb-4">{t.leadershipPrinciples}</h3>
            <ul class="space-y-2 text-gray-700">
              <li>* {t.leadByExample}</li>
              <li>* {t.fosterCollaboration}</li>
              <li>* {t.investInTeam}</li>
              <li>* {t.communicateClearly}</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Languages -->
      {t.langItems && (
        <section class="mb-12">
          <h2 class="text-2xl font-semibold mb-6">{t.languages}</h2>
          <div class="grid grid-cols-3 gap-4">
            {t.langItems.map((l: any) => (
              <div class="bg-gradient-to-br from-violet-50 to-violet-100 border border-violet-200 rounded-xl p-5 text-center">
                <div class="text-3xl mb-2">{l.flag}</div>
                <p class="font-semibold text-gray-800">{l.name}</p>
                <p class="text-xs text-violet-600 font-medium mt-1">{l.level}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Interests & Hobbies -->
      <section class="mb-12">
        <h2 class="text-2xl font-semibold mb-8">{t.beyondWork}</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="text-center">
            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 11-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <h3 class="font-semibold mb-2">{t.openSource}</h3>
            <p class="text-sm text-gray-600">{t.openSourceDesc}</p>
          </div>
          
          <div class="text-center">
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
              </svg>
            </div>
            <h3 class="font-semibold mb-2">{t.speaking}</h3>
            <p class="text-sm text-gray-600">{t.speakingDesc}</p>
          </div>
          
          <div class="text-center">
            <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 class="font-semibold mb-2">{t.writing}</h3>
            <p class="text-sm text-gray-600">{t.writingDesc}</p>
          </div>
        </div>
      </section>

      <!-- Contact CTA -->
      <section class="bg-gradient-to-r from-blue-600 to-purple-600 rounded-lg p-8 text-white text-center">
        <h2 class="text-2xl font-semibold mb-4">{t.connect}</h2>
        <p class="text-lg opacity-90 mb-6">
          {t.connectDesc}
        </p>
        <a href={`/${lang}/contact`} class="inline-flex items-center gap-2 px-6 py-3 bg-white text-blue-600 rounded-lg hover:bg-gray-100 transition-colors font-medium">
          {t.getInTouch}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </section>

    </div>
  </main>
  
