const personalInfo = getPersonalInfo(lang);
const currentPath = `/${lang}/about`;
const currentLang = lang;
const canonical = `https://elie-e.github.io/${lang}/about`;
const title = `About - ${personalInfo.name}`;
const description = `Learn more about ${personalInfo.name}, his journey, values, and approach to technology and leadership`;

