const posts = blogPosts[lang as keyof typeof blogPosts] || blogPosts.en;
---

<Layout 
  title={title}
  description={description}
  canonical={canonical}
  currentPath={currentPath}
  currentLang={currentLang}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-bold mb-4">{t.title}</h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          {t.subtitle}
        </p>
      </div>

      <!-- Featured Post -->
      <section class="mb-12">
        <div class="bg-gradient-to-r from-blue-600 to-purple-600 rounded-lg p-8 text-white">
          <div class="flex items-center gap-2 mb-4">
            <span class="px-3 py-1 bg-white bg-opacity-20 rounded-full text-sm">{t.featured}</span>
            <span class="text-sm opacity-90">{posts[0].date}</span>
            <span class="text-sm opacity-90">*</span>
            <span class="text-sm opacity-90">{posts[0].readTime} {t.minRead}</span>
          </div>
          <h2 class="text-2xl md:text-3xl font-bold mb-4">{posts[0].title}</h2>
          <p class="text-lg opacity-90 mb-6">{posts[0].excerpt}</p>
          <a href={`/${lang}/blog/${posts[0].slug}`} class="inline-flex items-center gap-2 px-6 py-3 bg-white text-blue-600 rounded-lg hover:bg-gray-100 transition-colors font-medium">
            {t.readMore}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </section>

      <!-- Blog Posts Grid -->
      <section class="mb-12">
        <h2 class="text-2xl font-semibold mb-8">{t.recentPosts}</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.slice(1).map(post => (
            <article class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-all duration-300 flex flex-col">
              <div class="mb-4">
                <span class={`px-3 py-1 rounded-full text-sm ${
                  post.category === 'Leadership' 
                    ? 'bg-green-100 text-green-800' 
                    : post.category === 'Web Development'
                    ? 'bg-blue-100 text-blue-800'
                    : 'bg-purple-100 text-purple-800'
                }`}>
                  {post.category}
                </span>
                <div class="text-xs text-gray-500 mt-1 pl-1">{post.readTime} {t.minRead}</div>
              </div>
              
              <h3 class="text-xl font-semibold mb-3">{post.title}</h3>
              <p class="text-gray-600 mb-4 leading-relaxed flex-grow">{post.excerpt}</p>
              
              <div class="flex justify-between items-center mt-auto">
                <a href={`/${lang}/blog/${post.slug}`} class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 font-medium">
                  {t.readMore}
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
                <span class="text-sm text-gray-600">{post.date}</span>
              </div>
            </article>
          ))}
        </div>
      </section>



    </div>
  </main>
</Layout>