---
import Layout from '../../layouts/Layout.astro';
import { getPersonalInfo, getTestimonials } from '../../data/index.js';
import { languages } from '../../types/index.js';

// Generate static paths for all languages
export async function getStaticPaths() {
  return languages.map(lang => ({
    params: { lang: lang.code }
  }));
}

// Get language from URL path
const lang = Astro.params.lang || 'en';
const personalInfo = getPersonalInfo(lang);
const testimonials = getTestimonials(lang);
const currentPath = `/${lang}/recommendations`;
const currentLang = lang;
const canonical = `https://www.oussematrabelsi.com/${lang}/recommendations`;
const title = `Recommendations - ${personalInfo.name}`;
const description = `Client recommendations and testimonials for ${personalInfo.name}`;

// Testimonials page translations
const testimonialsTranslations = {
  fr: {
    title: 'Recommandations',
    subtitle: 'Ce que disent mes clients et partenaires professionnels',
    viewProject: 'Voir le projet',
    clientSince: 'Client depuis',
    projectType: 'Type de projet',
    rating: 'Note'
  },
  en: {
    title: 'Recommendations',
    subtitle: 'What my clients and professional partners say',
    viewProject: 'View Project',
    clientSince: 'Client since',
    projectType: 'Project type',
    rating: 'Rating'
  },
  es: {
    title: 'Recomendaciones',
    subtitle: 'Lo que dicen mis clientes y socios profesionales',
    viewProject: 'Ver Proyecto',
    clientSince: 'Cliente desde',
    projectType: 'Tipo de proyecto',
    rating: 'Calificación'
  },
  de: {
    title: 'Empfehlungen',
    subtitle: 'Was meine Kunden und professionellen Partner sagen',
    viewProject: 'Projekt anzeigen',
    clientSince: 'Kunde seit',
    projectType: 'Projekttyp',
    rating: 'Bewertung'
  },
  pt: {
    title: 'Recomendações',
    subtitle: 'O que dizem meus clientes e parceiros profissionais',
    viewProject: 'Ver Projeto',
    clientSince: 'Cliente desde',
    projectType: 'Tipo de projeto',
    rating: 'Avaliação'
  },
  ja: {
    title: '推薦',
    subtitle: 'クライアントと専門パートナーからの評価',
    viewProject: 'プロジェクトを見る',
    clientSince: 'クライアント開始',
    projectType: 'プロジェクトタイプ',
    rating: '評価'
  },
  ko: {
    title: '추천',
    subtitle: '고객과 전문 파트너들의 평가',
    viewProject: '프로젝트 보기',
    clientSince: '고객 시작',
    projectType: '프로젝트 유형',
    rating: '평가'
  },
  zh: {
    title: '推荐',
    subtitle: '客户和专业合作伙伴的评价',
    viewProject: '查看项目',
    clientSince: '客户开始',
    projectType: '项目类型',
    rating: '评分'
  },
  ar: {
    title: 'التوصيات',
    subtitle: 'ما يقوله عملائي وشركائي المهنيون',
    viewProject: 'عرض المشروع',
    clientSince: 'عميل منذ',
    projectType: 'نوع المشروع',
    rating: 'التقييم'
  }
};

const t = testimonialsTranslations[lang as keyof typeof testimonialsTranslations] || testimonialsTranslations.en;
---

<Layout 
  title={title}
  description={description}
  canonical={canonical}
  currentPath={currentPath}
  currentLang={currentLang}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-bold mb-4">{t.title}</h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          {t.subtitle}
        </p>
      </div>

      <!-- Regular Testimonials -->
      <div class="space-y-12">
        {testimonials.slice(0, -3).map((testimonial, index) => (
          <div id={testimonial.id} class="bg-white rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow duration-300">
            <div class="flex flex-col md:flex-row gap-6">
              <!-- Client Info -->
              <div class="md:w-1/3">
                <div class="flex items-center gap-4 mb-4">
                  <img src={testimonial.image} alt={testimonial.name} class="w-16 h-16 rounded-full object-cover border-2 border-blue-200"/>
                  <div>
                    <h3 class="text-xl font-semibold">{testimonial.name}</h3>
                    <p class="text-gray-600">{testimonial.role}</p>
                    <p class="text-blue-600 font-medium">{testimonial.company}</p>
                  </div>
                </div>
                
                <!-- Rating -->
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-sm font-medium">{t.rating}:</span>
                  <div class="flex">
                    {Array.from({length: testimonial.rating}).map(() => (
                      <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                        <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                      </svg>
                    ))}
                  </div>
                </div>
                
                <!-- Project Info -->
                <div class="space-y-2 text-sm">
                  <div>
                    <span class="font-medium">{t.clientSince}:</span>
                    <span class="ml-2 text-gray-600">{testimonial.clientSince}</span>
                  </div>
                  <div>
                    <span class="font-medium">{t.projectType}:</span>
                    <span class="ml-2 text-gray-600">{testimonial.projectType}</span>
                  </div>
                </div>
                
                {testimonial.projectUrl && testimonial.projectUrl !== '#' && (
                  <a href={testimonial.projectUrl} target="_blank" rel="noopener noreferrer" 
                     class="inline-block mt-4 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-sm">
                    {t.viewProject}
                  </a>
                )}
              </div>
              
              <!-- Testimonial Content -->
              <div class="md:w-2/3">
                <div class="relative">
                  <svg class="absolute -top-2 -left-2 w-8 h-8 text-blue-200" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h4v10h-10z"/>
                  </svg>
                  <blockquote class="text-gray-700 leading-relaxed pl-6">
                    <p class="mb-4 text-lg italic">"{testimonial.testimonial}"</p>
                    <p class="text-gray-600">{testimonial.fullTestimonial}</p>
                  </blockquote>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Freelancer Recommendations Row (3 columns) - At the end -->
      <div class="mt-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {testimonials.slice(-3).map(testimonial => (
            <div id={testimonial.id} class="bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition-shadow duration-300">
              <!-- Client Info -->
              <div class="flex items-center gap-4 mb-4">
                <img src={testimonial.image} alt={testimonial.name} class="w-12 h-12 rounded-full object-cover border-2 border-blue-200"/>
                <div class="flex-1">
                  <h3 class="font-semibold text-sm">{testimonial.name}</h3>
                  <p class="text-xs text-gray-600">{testimonial.role}</p>
                  <p class="text-xs text-blue-600 font-medium">{testimonial.company}</p>
                </div>
                <div class="text-right">
                  <div class="flex mb-1">
                    {Array.from({length: testimonial.rating}).map(() => (
                      <svg class="w-3 h-3 text-yellow-400 fill-current" viewBox="0 0 20 20">
                        <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                      </svg>
                    ))}
                  </div>
                  <p class="text-xs text-gray-500">{testimonial.clientSince}</p>
                </div>
              </div>
              
              <!-- Testimonial Content -->
              <div class="mb-4">
                <blockquote class="text-gray-700 text-sm italic">
                  "{testimonial.testimonial}"
                </blockquote>
              </div>
              
              <!-- Project Info -->
              <div class="space-y-1 text-xs mb-4">
                <div>
                  <span class="font-medium">{t.projectType}:</span>
                  <span class="text-gray-600">{testimonial.projectType}</span>
                </div>
              </div>
              
              <!-- Project Link -->
              {testimonial.projectUrl && testimonial.projectUrl !== '#' && (
                <div class="text-center">
                  <a href={testimonial.projectUrl} target="_blank" rel="noopener noreferrer" 
                     class="inline-flex items-center gap-1 px-3 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-xs">
                    <span>{t.viewProject}</span>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                  </a>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </main>
  
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": t.title,
    "description": t.subtitle,
    "url": canonical,
    "mainEntity": {
      "@type": "Service",
      "name": `${personalInfo.name} - ${personalInfo.title}`,
      "description": personalInfo.bio,
      "url": "https://www.oussematrabelsi.com",
      "image": "https://www.oussematrabelsi.com/images/oussema-trabelsi-cto.png",
      "provider": {
        "@type": "Person",
        "name": personalInfo.name,
        "jobTitle": personalInfo.title
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": (testimonials.reduce((sum, t) => sum + t.rating, 0) / testimonials.length).toFixed(1),
        "reviewCount": testimonials.length,
        "bestRating": 5,
        "worstRating": 1
      },
      "review": testimonials.map(testimonial => ({
        "@type": "Review",
        "author": {
          "@type": "Person",
          "name": testimonial.name
        },
        "reviewBody": testimonial.fullTestimonial,
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": testimonial.rating,
          "bestRating": 5
        }
      }))
    },
    "inLanguage": lang
  })} />
</Layout>
