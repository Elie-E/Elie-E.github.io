      </div>
      <div class="contact-grid">
        <article class="card">
          <div class="card-header"><h3 class="card-title">{t.contact.formTitle}</h3><span class="card-pill">{t.contact.formPill}</span></div>
          <div class="card-body">
            <form class="contact-form" id="contactForm">
              <input type="text" name="_hp" tabindex="-1" autocomplete="off" style="display:none" />
              <div class="field">
                <label for="cf-name">{t.contact.fields.name}</label>
                <input id="cf-name" name="name" type="text" placeholder={t.contact.fields.namePh} required />
              </div>
              <div class="field">
                <label for="cf-email">{t.contact.fields.email}</label>
                <input id="cf-email" name="email" type="email" placeholder={t.contact.fields.emailPh} required />
              </div>
              <div class="field">
                <label for="cf-type">{t.contact.fields.type}</label>
                <input id="cf-type" name="type" type="text" placeholder={t.contact.fields.typePh} />
              </div>
              <div class="field">
                <label for="cf-budget">{t.contact.fields.budget}</label>
                <input id="cf-budget" name="budget" type="text" placeholder={t.contact.fields.budgetPh} />
              </div>
              <div class="field">
                <label for="cf-message">{t.contact.fields.message}</label>
                <textarea id="cf-message" name="message" rows="4" placeholder={t.contact.fields.messagePh} required></textarea>
              </div>
              <button class="btn-neon" type="submit" id="submitBtn">
