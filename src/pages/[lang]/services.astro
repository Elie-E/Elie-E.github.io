                <span>{t.contact.send}</span>
              </button>
              <p id="formStatus" style="font-size:12px;font-family:var(--font-code);margin-top:6px;display:none;"></p>
            </form>
          </div>
        </article>
        <article class="card">
          <div class="card-header"><h3 class="card-title">{t.contact.sideTitle}</h3><span class="card-pill">{t.contact.sidePill}</span></div>
          <div class="card-body contact-side">
            <p>{t.contact.sideDesc}</p>
            <ul>
              {t.contact.sideItems.map((item: string) => <li>{item}</li>)}
            </ul>
            <div class="contact-links">
              <!-- <a class="contact-link-pill" href={`mailto:${personalInfo.email}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 6a2 2 0 0 1 2-2h12c1.1 0 2 .9 2 2v.35l-8 4.8-8-4.8V6Zm0 2.85V18a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8.85l-7.4 4.44a2.5 2.5 0 0 1-2.6 0L4 8.85Z"/></svg>
                <span>Email</span>
              </a> -->
              <!-- <a class="contact-link-pill" href="https://linkedin.com/in/alban-augier-a64297108/" target="_blank" rel="noreferrer">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z" clip-rule="evenodd"/></svg>
                <span>LinkedIn</span>
              </a> -->
              <!-- <a class="contact-link-pill" href="https://github.com/Elie-E" target="_blank" rel="noreferrer">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
                <span>GitHub</span>
