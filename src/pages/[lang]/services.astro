        </div>
        <div class="hero-meta">
          <span><strong>{t.hero.metaLaunch}</strong> {t.hero.metaLaunchRest}</span>
          <span><strong>{t.hero.metaFix}</strong> {t.hero.metaFixRest}</span>
          <span><strong>{t.hero.metaMaintain}</strong> {t.hero.metaMaintainRest}</span>
        </div>
