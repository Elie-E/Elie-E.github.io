    },
    contact: {
      label: '/contact', title: 'Dites-moi ce dont vous avez besoin',
      desc: 'Quelques paragraphes suffisent. Je répondrai avec des questions, une première direction et une fourchette de budget.',
      formTitle: 'Brief projet', formPill: 'Message',
      fields: { name: 'Nom / entreprise', namePh: 'À qui dois-je répondre ?', email: 'Email', emailPh: 'vous@entreprise.com', type: 'De quoi avez-vous besoin ?', typePh: 'Nouveau site, debug, maintenance, évolution...', budget: 'Budget approximatif (optionnel)', budgetPh: 'ex. 500–1k, 1–3k, 5–10k, pas encore sûr', message: 'Détails du projet', messagePh: 'Dites-moi ce qui est cassé, ce que vous voulez changer, ou ce que vous voulez lancer.' },
      send: 'Envoyer le message', sending: 'Envoi en cours...', success: '✓ Message reçu. Je vous répondrai rapidement.', error: '✗ Quelque chose s\'est mal passé. Essayez d\'envoyer un email directement.',
