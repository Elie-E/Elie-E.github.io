          <strong>{t.hero.maintain}</strong> {t.hero.desc4}
        </p>
        <div class="hero-tags">
          {t.hero.tags.map((tag: string) => <span class="hero-tag">{tag}</span>)}
        </div>
        <div class="hero-actions">
          <a class="btn-neon" href="#services">
            <span class="dot"></span>
            <span>{t.hero.viewServices}</span>
