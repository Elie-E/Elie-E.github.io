    services: {
      label: '/servicios', title: 'Formas claras de trabajar juntos',
      desc: 'Empieza pequeño (un arreglo) o construye completo (nuevo sitio). Todo está bien definido para que nunca haya sorpresas.',
      cards: [
        { num: '01', title: 'Nuevo sitio web o rediseño', pill: 'Creación', body: 'Para cuando tu sitio actual se siente antiguo, fuera de marca, o aún no tienes uno.', items: ['Estructura & maquetación adaptada a tu contenido', 'Diseño & desarrollo (sin tema genérico)', 'Rendimiento & revisión SEO básica', 'Soporte en el lanzamiento & traspaso'], note: 'Alcance típico: landing page / pequeño sitio de marketing.' },
        { num: '02', title: 'Debug & misiones de rescate', pill: 'Correcciones', body: '¿Algo está roto o lento? Investigo, explico claramente y lo corrijo.', items: ['Layouts rotos (frecuentemente solo en móvil)', 'Formularios, checkout o login fallando', 'Errores & crashes aleatorios', 'Ralentizaciones repentinas tras actualizaciones'], note: 'Normalmente comienza con un diagnóstico + corrección a precio fijo.' },
        { num: '03', title: 'Mantenimiento & planes de cuidado', pill: 'Continuo', body: 'Para empresas que dependen de su sitio web y quieren que se mantenga en buen estado.', items: ['Actualizaciones regulares & parches de seguridad', 'Monitoreo & alertas de error', 'Copias de seguridad & plan de reversión', 'Pequeñas ediciones de contenido cada mes'], note: 'Objetivo: tu sitio se mantiene estable en segundo plano sin esfuerzo.' },
        { num: '04', title: 'Evolución & nuevas funcionalidades', pill: 'Crecimiento', body: 'Tu sitio funciona, pero quieres que haga más: mejor UX, nuevos flujos, integraciones.', items: ['Nuevas páginas, componentes & maquetaciones', 'Integraciones (herramientas de email, pagos, analytics)', 'Mejoras de UX & reestructuración de contenido', 'Pequeños experimentos (pruebas A/B)'], note: 'Basado en proyecto o horas reservadas mensualmente.' },
      ],
    },
    process: {
      label: '/proceso', title: 'Flujo de colaboración simple',
      desc: 'Sin reuniones interminables. Un camino claro de "tenemos un problema" a "esto se siente mucho mejor".',
