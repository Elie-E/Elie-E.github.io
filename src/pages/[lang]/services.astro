const t = translations[lang as keyof typeof translations] ?? translations.en;
const description = t.description;

const langLabels: Record<string, { label: string; flag: string }> = {
  en: { label: 'EN', flag: '🇬🇧' },
  fr: { label: 'FR', flag: '🇫🇷' },
  es: { label: 'ES', flag: '🇪🇸' },
};
---

<!DOCTYPE html>
<html lang={lang} data-theme="aurora">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Services - {personalInfo.name}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;700&family=Space+Grotesk:wght@300;500;700&display=swap" rel="stylesheet" />
  <style>
    /* =========================================================
       THEME SYSTEM
       ========================================================= */

    :root {
      --bg: #050505;
      --bg-alt: #050818;
      --panel: rgba(15, 15, 20, 0.98);
      --primary: #00ff9d;
      --accent: #bd00ff;
      --cyan: #00f3ff;
      --sun: #00f3ff;
      --pink: #bd00ff;
      --text: #e0e6ed;
      --muted: #8892b0;
      --border: rgba(255, 255, 255, 0.08);
      --shadow-soft: 0 0 40px rgba(0, 0, 0, 0.8);
      --radius-lg: 18px;
      --radius-pill: 999px;
      --transition-fast: 0.2s ease-out;
      --font-display: 'Space Grotesk', sans-serif;
      --font-code: 'JetBrains Mono', monospace;
      --bg-radial-1: rgba(189, 0, 255, 0.18);
      --bg-radial-2: rgba(0, 243, 255, 0.14);
      --bg-radial-3: rgba(0, 255, 157, 0.10);
      --grid-a: rgba(189, 0, 255, 0.95);
      --grid-b: rgba(0, 243, 255, 0.85);
      --nav-bg: rgba(10, 10, 10, 0.7);
      --btn-border: rgba(0, 255, 157, 0.9);
      --btn-bg: rgba(0, 0, 0, 0.9);
      --btn-text: var(--primary);
      --btn-hover-bg: var(--primary);
      --btn-hover-text: #000;
      --term-bg: rgba(15, 15, 20, 0.98);
      --term-prefix: var(--accent);
      --term-command: var(--cyan);
      --term-output: var(--muted);
      --cursor: var(--primary);
      --card-bg: rgba(10,10,15,0.95);
      --card-pill-border: rgba(189, 0, 255, 0.6);
      --card-pill-bg: rgba(189, 0, 255, 0.18);
      --card-pill-text: #ffd3ff;
      --sun-opacity: 0;
    }

    html[data-theme="synthwave"] {
      --bg: #070014;
      --bg-alt: #0b0030;
      --panel: rgba(10, 3, 24, 0.88);
      --sun: #ffcc33;
      --pink: #ff2bd6;
      --accent: #7a2cff;
      --cyan: #00e6ff;
      --primary: var(--cyan);
      --text: #f3f0ff;
      --muted: #b2a9d6;
      --border: rgba(255, 255, 255, 0.10);
      --shadow-soft: 0 20px 60px rgba(0, 0, 0, 0.75);
      --bg-radial-1: rgba(255, 43, 214, 0.25);
      --bg-radial-2: rgba(0, 230, 255, 0.16);
      --bg-radial-3: rgba(122, 44, 255, 0.18);
      --grid-a: rgba(255, 43, 214, 0.95);
      --grid-b: rgba(0, 230, 255, 0.85);
      --nav-bg: rgba(10, 3, 24, 0.68);
      --btn-border: rgba(255, 43, 214, 0.85);
      --btn-bg: rgba(0, 0, 0, 0.35);
      --btn-text: var(--text);
      --btn-hover-bg: var(--primary);
      --btn-hover-text: var(--text);
      --term-bg: rgba(10, 3, 24, 0.88);
      --term-prefix: var(--pink);
      --term-command: var(--sun);
      --term-output: rgba(243, 240, 255, 0.70);
      --cursor: var(--cyan);
      --card-bg: rgba(18, 8, 45, 0.75);
      --card-pill-border: rgba(255, 204, 51, 0.35);
      --card-pill-bg: rgba(255, 204, 51, 0.10);
      --card-pill-text: rgba(255, 204, 51, 0.95);
      --sun-opacity: 0.22;
    }

    html[data-theme="aurora"] {
      --bg: #f7fbff;
      --bg-alt: #edf5ff;
      --panel: rgba(255, 255, 255, 0.78);

      --primary: #2563eb;
      --accent: #7c3aed;
      --cyan: #06b6d4;
      --sun: #f59e0b;
      --pink: #ec4899;

      --text: #0f172a;
      --muted: #526075;
      --border: rgba(15, 23, 42, 0.10);

      --shadow-soft: 0 24px 70px rgba(15, 23, 42, 0.14);

      --bg-radial-1: rgba(124, 58, 237, 0.14);
      --bg-radial-2: rgba(6, 182, 212, 0.16);
      --bg-radial-3: rgba(37, 99, 235, 0.10);

      --grid-a: rgba(124, 58, 237, 0.28);
      --grid-b: rgba(6, 182, 212, 0.30);

      --nav-bg: rgba(255, 255, 255, 0.72);

      --btn-border: rgba(37, 99, 235, 0.70);
      --btn-bg: rgba(255, 255, 255, 0.84);
      --btn-text: #1d4ed8;
      --btn-hover-bg: #2563eb;
      --btn-hover-text: #ffffff;

      --term-bg: rgba(255, 255, 255, 0.78);
      --term-prefix: #7c3aed;
      --term-command: #0891b2;
      --term-output: rgba(15, 23, 42, 0.68);

      --cursor: #2563eb;

      --card-bg: rgba(255, 255, 255, 0.72);
      --card-pill-border: rgba(37, 99, 235, 0.22);
      --card-pill-bg: rgba(37, 99, 235, 0.08);
      --card-pill-text: #1d4ed8;

      --sun-opacity: 0.12;
    }

    html[data-theme="aurora"] body {
      background:
        radial-gradient(1000px 620px at 72% -10%, var(--bg-radial-1), transparent 56%),
        radial-gradient(820px 560px at 12% 12%, var(--bg-radial-2), transparent 58%),
        radial-gradient(760px 560px at 58% 92%, var(--bg-radial-3), transparent 62%),
        linear-gradient(180deg, var(--bg-alt), var(--bg));
    }

    html[data-theme="aurora"] .crt-overlay,
    html[data-theme="aurora"] .noise {
      opacity: 0.03;
    }

    html[data-theme="aurora"] .nav-inner {
      box-shadow: 0 18px 50px rgba(15, 23, 42, 0.10);
    }

    html[data-theme="aurora"] .logo-pill,
    html[data-theme="aurora"] .pill-muted,
    html[data-theme="aurora"] .hero-tag,
    html[data-theme="aurora"] .btn-ghost,
    html[data-theme="aurora"] .theme-switch,
    html[data-theme="aurora"] .switch-btn,
    html[data-theme="aurora"] .contact-link-pill,
    html[data-theme="aurora"] .hint-pill,
    html[data-theme="aurora"] .terminal-status-pill {
      background: rgba(255, 255, 255, 0.68);
      border-color: rgba(15, 23, 42, 0.12);
      color: rgba(15, 23, 42, 0.76);
    }

    html[data-theme="aurora"] .nav-links {
      color: rgba(15, 23, 42, 0.62);
    }

    html[data-theme="aurora"] .nav-links a:hover {
      color: var(--text);
    }

    html[data-theme="aurora"] .hero-subtitle,
    html[data-theme="aurora"] .section-label,
    html[data-theme="aurora"] .field label {
      color: rgba(15, 23, 42, 0.58);
    }

    html[data-theme="aurora"] .hero-description,
    html[data-theme="aurora"] .section-description,
    html[data-theme="aurora"] .card-body,
    html[data-theme="aurora"] .contact-side {
      color: rgba(15, 23, 42, 0.68);
    }

    html[data-theme="aurora"] .card-body ul li,
    html[data-theme="aurora"] .card-note,
    html[data-theme="aurora"] .hero-meta {
      color: rgba(15, 23, 42, 0.58);
    }

    html[data-theme="aurora"] .terminal-window,
    html[data-theme="aurora"] .card {
      border-color: rgba(15, 23, 42, 0.10);
      box-shadow: 0 24px 70px rgba(15, 23, 42, 0.12);
      backdrop-filter: blur(18px);
    }

    html[data-theme="aurora"] .terminal-header {
      background: rgba(248, 250, 252, 0.72);
      border-bottom-color: rgba(15, 23, 42, 0.08);
    }

    html[data-theme="aurora"] .field input,
    html[data-theme="aurora"] .field textarea {
      background: rgba(255, 255, 255, 0.72);
      border-color: rgba(15, 23, 42, 0.12);
      color: var(--text);
    }

    html[data-theme="aurora"] .field input::placeholder,
    html[data-theme="aurora"] .field textarea::placeholder {
      color: rgba(15, 23, 42, 0.42);
    }

    html[data-theme="aurora"] footer {
      background: rgba(255, 255, 255, 0.54);
      border-top-color: rgba(15, 23, 42, 0.08);
      color: rgba(15, 23, 42, 0.52);
    }

    html[data-theme="aurora"] .hero-title .accent {
      background: linear-gradient(90deg, #4f46e5, #06b6d4, #2563eb);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: none;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body {
      font-family: var(--font-display);
      color: var(--text);
      background:
        radial-gradient(1200px 700px at 70% -10%, var(--bg-radial-1), transparent 55%),
        radial-gradient(900px 650px at 20% 10%, var(--bg-radial-2), transparent 55%),
        radial-gradient(850px 650px at 60% 90%, var(--bg-radial-3), transparent 55%),
        linear-gradient(180deg, var(--bg-alt), var(--bg));
      overflow-x: hidden;
      line-height: 1.6;
      position: relative;
      scroll-behavior: smooth;
    }
    a { color: inherit; text-decoration: none; }

    /* CRT overlay */
    .crt-overlay {
      position: fixed; inset: 0; pointer-events: none; z-index: 8;
      background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0,0,0,0.12) 50%, rgba(0,0,0,0.12));
      background-size: 100% 4px;
      animation: scanlines 0.22s linear infinite;
      opacity: 0.28; mix-blend-mode: soft-light;
    }
    @keyframes scanlines { 0% { background-position: 0 0; } 100% { background-position: 0 4px; } }

    .noise {
      position: fixed; inset: 0; pointer-events: none; z-index: 7; opacity: 0.07;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='noStitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.7'/%3E%3C/svg%3E");
      mix-blend-mode: soft-light;
    }

    .sun {
      position: fixed; left: 50%; top: 64%; transform: translate(-50%, -50%);
      width: min(520px, 70vw); height: min(520px, 70vw); border-radius: 50%;
      background:
        radial-gradient(circle at 50% 40%, rgba(255,204,51,0.92), rgba(255,43,214,0.30) 55%, transparent 70%),
        radial-gradient(circle at 50% 60%, rgba(255,204,51,0.18), transparent 70%);
      opacity: var(--sun-opacity); z-index: -2; pointer-events: none;
      mask-image: linear-gradient(to top, black 0%, transparent 68%);
      -webkit-mask-image: linear-gradient(to top, black 0%, transparent 68%);
    }

    .perspective-grid {
      position: fixed; width: 220%; height: 100vh; bottom: -30vh; left: -60%;
      background-image: linear-gradient(var(--grid-a) 1px, transparent 1px), linear-gradient(90deg, var(--grid-b) 1px, transparent 1px);
      background-size: 52px 52px;
      transform: perspective(520px) rotateX(62deg);
      opacity: 0.16; z-index: -3;
      animation: gridMove 18s linear infinite;
      mask-image: linear-gradient(to top, black 0%, transparent 80%);
      -webkit-mask-image: linear-gradient(to top, black 0%, transparent 80%);
    }
    @keyframes gridMove { from { background-position: 0 0; } to { background-position: 0 52px; } }

    /* NAV */
    .nav {
      position: fixed;
      top: 18px;
      left: 0;
      right: 0;
      display: flex;
      justify-content: center;
      padding: 0 20px;
      z-index: 20;
      pointer-events: none;
      transition: top 0.22s ease-out, padding 0.22s ease-out;
    }
    .nav.is-scrolled {
      top: 0;
      padding: 0;
    }

    .nav-inner {
      width: 100%;
      max-width: 1120px;
      border-radius: 999px;
      background: var(--nav-bg);
      border: 1px solid var(--border);
      backdrop-filter: blur(14px);
      box-shadow: 0 10px 34px rgba(0,0,0,0.7);
      padding: 10px 18px;
      pointer-events: auto;
      position: relative;
      overflow: visible;
      transition:
        max-width 0.22s ease-out,
        border-radius 0.22s ease-out,
        padding 0.22s ease-out,
        border-color 0.22s ease-out,
        box-shadow 0.22s ease-out,
        background 0.22s ease-out;
    }

    .nav.is-scrolled .nav-inner {
      max-width: none;
      border-radius: 0;
      padding: 12px 24px;
      border-left: none;
      border-right: none;
      border-top: none;
    }
    .nav-inner::after {
      content: ""; position: absolute; top: -30%; left: -30%; width: 60%; height: 180%;
      background: linear-gradient(120deg, transparent, rgba(255,255,255,0.10), transparent);
      transform: rotate(18deg); animation: sweep 7s linear infinite; opacity: 0.55; pointer-events: none;
    }
    @keyframes sweep { 0% { transform: translateX(-20%) rotate(18deg); } 100% { transform: translateX(210%) rotate(18deg); } }

    .nav-content {
      width: 100%;
      max-width: 1120px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    
    .logo-pill {
      border-radius: 999px; padding: 6px 12px; border: 1px solid rgba(255,255,255,0.12);
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 12px; text-transform: uppercase; letter-spacing: 0.12em;
      font-family: var(--font-code); color: var(--cyan); background: rgba(0,0,0,0.25);
      position: relative; z-index: 1; user-select: none;
    }
    .logo-dot {
      width: 8px; height: 8px; border-radius: 999px; background: var(--primary);
      box-shadow: 0 0 12px rgba(0,255,157,0.9);
    }
    html[data-theme="synthwave"] .logo-dot { background: var(--pink); box-shadow: 0 0 14px rgba(255,43,214,0.9); }

    .nav-links {
      display: flex; align-items: center; gap: 22px; font-size: 12px;
      text-transform: uppercase; letter-spacing: 0.12em; color: rgba(255,255,255,0.68);
      font-family: var(--font-code); position: relative; z-index: 1;
    }
    .nav-links a { position: relative; padding-bottom: 2px; transition: color var(--transition-fast); }
    .nav-links a::after {
      content: ""; position: absolute; left: 0; bottom: 0; width: 0; height: 1px;
      background: linear-gradient(90deg, var(--accent), var(--cyan)); transition: width var(--transition-fast);
    }
    .nav-links a:hover { color: var(--text); }
    .nav-links a:hover::after { width: 100%; }

    .nav-cta { display: flex; align-items: center; gap: 10px; font-family: var(--font-code); position: relative; z-index: 1; }

    .pill-muted {
      border-radius: 999px; padding: 4px 10px; font-size: 11px; color: rgba(255,255,255,0.78);
      border: 1px solid rgba(255,255,255,0.12); background: rgba(0,0,0,0.25);
      text-transform: uppercase; letter-spacing: 0.14em; white-space: nowrap;
    }

    .btn-neon {
      border-radius: 999px; padding: 8px 16px; font-size: 11px;
      text-transform: uppercase; letter-spacing: 0.16em;
      border: 1px solid var(--btn-border); background: var(--btn-bg); color: var(--btn-text);
      display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
      transition: transform 0.18s ease-out, box-shadow 0.18s ease-out, background 0.18s ease-out, color 0.18s ease-out;
      font-family: var(--font-code); white-space: nowrap; text-decoration: none;
    }
    .btn-neon span.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 12px rgba(0,243,255,0.55); }
    html[data-theme="cyberpunk"] .btn-neon:hover { transform: translateY(-1px); box-shadow: var(--shadow-soft); background: var(--btn-hover-bg); color: var(--btn-hover-text); }
    html[data-theme="synthwave"] .btn-neon:hover { transform: translateY(-1px); box-shadow: 0 0 30px rgba(255,43,214,0.25), 0 0 40px rgba(0,230,255,0.2); border-color: rgba(0,230,255,0.7); }

    .lang-dropdown-wrap { position: relative; z-index: 200; }
    .lang-toggle-btn {
      display: inline-flex; align-items: center; gap: 5px;
      border: 1px solid rgba(255,255,255,0.16); background: rgba(0,0,0,0.25);
      color: rgba(255,255,255,0.85); border-radius: 999px; padding: 6px 12px;
      font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
      font-family: var(--font-code); cursor: pointer; transition: 0.18s ease-out;
    }
    .lang-toggle-btn:hover { border-color: rgba(0,243,255,0.35); color: var(--text); }
    html[data-theme="aurora"] .lang-toggle-btn { color: rgba(15,23,42,0.78); background: rgba(255,255,255,0.72); border-color: rgba(15,23,42,0.14); }
    html[data-theme="aurora"] .lang-toggle-btn:hover { color: #0f172a; border-color: rgba(37,99,235,0.35); background: rgba(255,255,255,0.92); }
    .lang-dropdown {
      display: none; position: absolute; top: calc(100% + 8px); right: 0;
      background: var(--panel); border: 1px solid var(--border);
      border-radius: 10px; overflow: hidden; min-width: 80px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.5);
      flex-direction: column;
    }
    .lang-dropdown.open { display: flex; }
    .lang-option {
      display: flex; align-items: center; gap: 8px;
      padding: 9px 16px; font-size: 11px; letter-spacing: 0.14em;
      text-transform: uppercase; font-family: var(--font-code);
      color: var(--muted); text-decoration: none; transition: 0.15s ease-out;
    }
    .lang-option:hover { background: rgba(255,255,255,0.05); color: var(--text); }
    .lang-option.active { color: var(--primary); }
    html[data-theme="aurora"] .lang-dropdown { background: #fff; border-color: rgba(0,0,0,0.08); box-shadow: 0 8px 24px rgba(0,0,0,0.12); }
    html[data-theme="aurora"] .lang-option { color: rgba(15,23,42,0.55); }
    html[data-theme="aurora"] .lang-option:hover { background: rgba(0,0,0,0.04); color: #0f172a; }
    html[data-theme="aurora"] .lang-option.active { color: #1d4ed8; }

    .theme-switch {
      display: inline-flex; align-items: center; gap: 8px;
      border: 1px solid rgba(255,255,255,0.12); border-radius: 999px;
      padding: 6px 10px; background: rgba(0,0,0,0.20); user-select: none;
    }
    .theme-label { font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.70); }
    html[data-theme="aurora"] .theme-label {
      color: rgba(15, 23, 42, 0.58);
    }
    html[data-theme="aurora"] .switch-btn {
      color: rgba(15, 23, 42, 0.78);
      background: rgba(255, 255, 255, 0.72);
      border-color: rgba(15, 23, 42, 0.14);
    }

    html[data-theme="aurora"] .switch-btn:hover {
      color: #0f172a;
      border-color: rgba(37, 99, 235, 0.35);
      background: rgba(255, 255, 255, 0.92);
    }
    .switch-btn {
      border: 1px solid rgba(255,255,255,0.16); background: rgba(0,0,0,0.25);
      color: rgba(255,255,255,0.85); border-radius: 999px; padding: 6px 10px;
      font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
      font-family: var(--font-code); cursor: pointer; transition: 0.18s ease-out;
    }
    .switch-btn:hover { transform: translateY(-1px); border-color: rgba(0,243,255,0.35); color: var(--text); }

    /* HERO */
    .hero {
      min-height: 100vh; display: flex; align-items: center; justify-content: center;
      padding: 120px 24px 72px; position: relative;
    }
    .hero-inner {
      width: 100%; max-width: 1120px;
      display: grid; grid-template-columns: minmax(0,1.2fr) minmax(0,1fr);
      gap: 64px; align-items: center;
    }
    .hero-subtitle {
      font-size: 13px; text-transform: uppercase; letter-spacing: 0.18em;
      color: rgba(255,255,255,0.65); margin-bottom: 18px; font-family: var(--font-code);
    }
    .hero-title { font-size: clamp(2.7rem, 4.8vw, 3.9rem); line-height: 1.1; margin-bottom: 20px; text-transform: uppercase; letter-spacing: -0.03em; }
    .hero-title .accent {
      background: linear-gradient(90deg, var(--accent), var(--cyan), var(--sun));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 12px rgba(255,255,255,0.08));
    }
    .hero-description { font-size: 1rem; color: rgba(255,255,255,0.72); max-width: 520px; margin-bottom: 26px; }
    .hero-description strong { color: var(--cyan); font-weight: 600; }
    .hero-tags { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 28px; }
    .hero-tag {
      font-family: var(--font-code); font-size: 11px; padding: 6px 12px;
      border-radius: 999px; border: 1px solid rgba(255,255,255,0.12);
      color: rgba(255,255,255,0.85); background: rgba(255,255,255,0.03);
    }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 18px; }
    .btn-ghost {
      border-radius: 999px; padding: 8px 16px; font-size: 11px;
      text-transform: uppercase; letter-spacing: 0.16em;
      border: 1px dashed rgba(255,255,255,0.25); color: rgba(255,255,255,0.75);
      background: rgba(0,0,0,0.25); display: inline-flex; align-items: center; gap: 8px;
      cursor: pointer; transition: 0.2s ease-out; font-family: var(--font-code); white-space: nowrap; text-decoration: none;
    }
    .btn-ghost svg { width: 14px; height: 14px; }
    .btn-ghost:hover { color: var(--text); border-style: solid; border-color: rgba(0,243,255,0.45); background: rgba(0,0,0,0.35); transform: translateY(-1px); }
    .hero-meta {
      display: flex; flex-wrap: wrap; gap: 16px; font-size: 11px;
      text-transform: uppercase; letter-spacing: 0.14em; color: rgba(255,255,255,0.58); font-family: var(--font-code);
    }
    .hero-meta span strong { color: var(--sun); margin-right: 6px; }

    /* Terminal */
    .hero-terminal-wrapper { position: relative; }
    .hero-terminal-outline {
      position: absolute; inset: -16px -18px -18px -18px;
      border-radius: calc(var(--radius-lg) + 12px);
      background: conic-gradient(from 210deg, rgba(255,255,255,0.10), rgba(255,255,255,0.08), rgba(255,255,255,0.06), transparent 65%);
      opacity: 0.75; filter: blur(20px); z-index: -2;
    }
    .terminal-window {
      border-radius: var(--radius-lg); border: 1px solid rgba(255,255,255,0.12);
      background: var(--term-bg); box-shadow: var(--shadow-soft); overflow: hidden;
      font-family: var(--font-code); font-size: 13px;
    }
    .terminal-header {
      background: rgba(255,255,255,0.04); padding: 10px 16px;
      display: flex; align-items: center; justify-content: space-between;
      border-bottom: 1px solid rgba(255,255,255,0.10);
    }
    .window-controls { display: flex; gap: 6px; align-items: center; }
    .window-dot { width: 9px; height: 9px; border-radius: 50%; background: #ff5f56; }
    .window-dot:nth-child(2) { background: #ffbd2f; }
    .window-dot:nth-child(3) { background: #27c93f; }
    .terminal-title { font-size: 11px; color: rgba(255,255,255,0.65); letter-spacing: 0.14em; text-transform: uppercase; }
    .terminal-status-pill {
      font-size: 10px; text-transform: uppercase; letter-spacing: 0.18em; border-radius: 999px;
      padding: 2px 8px; border: 1px solid rgba(255,255,255,0.16); color: var(--cyan);
      background: rgba(0,0,0,0.35); display: inline-flex; align-items: center; gap: 6px;
    }
    .status-dot {
      width: 6px; height: 6px; border-radius: 999px; background: var(--cyan);
      box-shadow: 0 0 9px rgba(0,243,255,0.5); animation: statusPulse 1.4s ease-in-out infinite;
    }
    @keyframes statusPulse { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.3); opacity: 0.6; } }
    .terminal-body { padding: 16px 18px 18px; height: 470px; overflow-y: hidden; position: relative; display: flex; flex-direction: column; }
    .terminal-line { display: block; margin-bottom: 4px; }
    .terminal-line span.prefix { color: var(--term-prefix); }
    .terminal-line span.command { color: var(--term-command); }
    .terminal-line span.output { color: var(--term-output); }
    .terminal-prompt { margin-top: 6px; display: flex; align-items: baseline; gap: 6px; }
    .terminal-input { display: inline-block; min-height: 1em; white-space: pre; }
    .terminal-cursor {
      display: inline-block; width: 8px; height: 1.1em; margin-left: 2px;
      background: var(--cursor); animation: cursorBlink 1s step-end infinite;
      box-shadow: 0 0 12px rgba(0,243,255,0.35);
    }
    @keyframes cursorBlink { 0%, 50% { opacity: 1; } 50.1%, 100% { opacity: 0; } }
    .terminal-footer-hints { margin-top: auto; padding-top: 10px; font-size: 11px; color: rgba(255,255,255,0.60); display: flex; flex-wrap: wrap; gap: 6px; }
    .hint-pill {
      border-radius: 999px; padding: 3px 8px; border: 1px solid rgba(255,255,255,0.12);
      background: rgba(0,0,0,0.28); display: inline-flex; align-items: center; gap: 4px;
    }
    .hint-pill code { font-family: var(--font-code); font-size: 11px; color: var(--accent); }
    html[data-theme="synthwave"] .hint-pill code { color: var(--pink); }

    /* Sections */
    main { padding: 0 24px 72px; }
    .section { max-width: 1120px; margin: 0 auto; padding: 92px 0 18px; }
    .section-header { margin-bottom: 42px; border-left: 2px solid rgba(0,243,255,0.45); padding-left: 18px; }
    .section-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em; color: rgba(255,255,255,0.62); font-family: var(--font-code); margin-bottom: 6px; }
    .section-title { font-size: 1.9rem; letter-spacing: 0.02em; text-transform: uppercase; }
    .section-description { font-size: 0.95rem; color: rgba(255,255,255,0.75); max-width: 520px; margin-top: 8px; }

    .grid-2 { display: flex; flex-direction: column; gap: 16px; }
    .card {
      border-radius: 16px; border: 1px solid rgba(255,255,255,0.12); background: var(--card-bg);
      box-shadow: 0 18px 44px rgba(0,0,0,0.72); padding: 0; position: relative; overflow: hidden;
    }
    .grid-2 .card { display: grid; grid-template-columns: minmax(200px, 260px) 1fr; }
    .card::before {
      content: ""; position: absolute; inset: 0;
      background: radial-gradient(circle at 0 0, rgba(255,255,255,0.06), transparent 55%);
      opacity: 0.7; mix-blend-mode: soft-light; pointer-events: none;
    }
    .card-header { display: flex; gap: 10px; padding: 22px 24px; }
    .grid-2 .card-header {
      flex-direction: column; justify-content: center;
      border-right: 1px solid rgba(255,255,255,0.08);
    }
    .contact-grid .card-header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .card-title { font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.12em; font-family: var(--font-code); }
    .card-pill {
      font-size: 10px; text-transform: uppercase; letter-spacing: 0.16em; border-radius: 999px;
      padding: 4px 10px; border: 1px solid var(--card-pill-border); color: var(--card-pill-text);
      background: var(--card-pill-bg); font-family: var(--font-code); white-space: nowrap;
    }
    .grid-2 .card-pill { align-self: flex-start; }
    .card-body { font-size: 0.93rem; color: rgba(255,255,255,0.72); padding: 22px 24px; }
    .contact-grid .card-body { padding-top: 0; }
    .card-body ul { list-style: none; margin: 10px 0 0; padding: 0; }
    .card-body ul li { margin-bottom: 5px; color: rgba(255,255,255,0.66); }
    .card-note { margin-top: 10px; font-size: 0.8rem; color: rgba(255,255,255,0.60); font-family: var(--font-code); }
    @media (max-width: 600px) {
      .grid-2 .card { grid-template-columns: 1fr; }
      .grid-2 .card-header { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.08); flex-direction: row; align-items: center; justify-content: space-between; }
    }

    /* Contact */
    .contact-grid { display: grid; grid-template-columns: minmax(0,1.1fr) minmax(0,0.9fr); gap: 26px; }
    .contact-form { display: grid; grid-template-columns: 1fr; gap: 12px; margin-top: 6px; }
    .field { display: grid; gap: 4px; font-size: 12px; }
    .field label { text-transform: uppercase; letter-spacing: 0.16em; color: rgba(255,255,255,0.62); font-size: 11px; font-family: var(--font-code); }
    .field input, .field textarea {
      border-radius: 10px; border: 1px solid rgba(255,255,255,0.12); background: rgba(0,0,0,0.28);
      padding: 10px 12px; color: var(--text); font-size: 13px; outline: none;
      resize: vertical; min-height: 42px; font-family: var(--font-display);
    }
    .field input:focus, .field textarea:focus { border-color: rgba(0,243,255,0.55); box-shadow: 0 0 0 1px rgba(0,243,255,0.35); }
    .contact-side { font-size: 0.95rem; color: rgba(255,255,255,0.68); }
    .contact-side ul { list-style: none; margin-top: 10px; padding: 0; display: grid; gap: 6px; }
    .contact-side li::before { content: "▸"; margin-right: 8px; color: var(--cyan); font-family: var(--font-code); font-size: 11px; }
    .contact-links { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 10px; }
    .contact-link-pill {
      border-radius: 999px; padding: 7px 12px; font-size: 12px; border: 1px solid rgba(255,255,255,0.14);
      color: rgba(255,255,255,0.90); background: rgba(0,0,0,0.25);
      display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
      transition: 0.2s ease-out; font-family: var(--font-code); text-decoration: none;
    }
    .contact-link-pill:hover { transform: translateY(-1px); box-shadow: 0 10px 24px rgba(0,0,0,0.8); background: rgba(255,255,255,0.06); border-color: rgba(0,243,255,0.35); }
    html[data-theme="synthwave"] .contact-link-pill:hover { background: linear-gradient(90deg, rgba(255,43,214,0.22), rgba(0,230,255,0.14)); border-color: rgba(0,230,255,0.6); }
    .contact-link-pill svg { width: 14px; height: 14px; }

    footer { padding: 24px; font-size: 11px; color: rgba(255,255,255,0.55); border-top: 1px solid rgba(255,255,255,0.10); background: rgba(0,0,0,0.20); }
    .footer-inner {
      max-width: 1120px; margin: 0 auto; display: flex; justify-content: space-between;
      gap: 10px; flex-wrap: wrap; font-family: var(--font-code); text-transform: uppercase; letter-spacing: 0.16em;
    }

    @media (max-width: 880px) {
      .hero-inner { grid-template-columns: 1fr; gap: 34px; }
      .hero { padding-top: 110px; }
      .nav-links { display: none; }
      .hero-meta { flex-direction: column; }
      .contact-grid { grid-template-columns: 1fr; }
      .theme-label { display: none; }
    }
    @media (max-width: 640px) {
      .hero-actions { flex-direction: column; align-items: flex-start; }
      .pill-muted { display: none; }
    }
  </style>
</head>

<body>
  <div class="sun" aria-hidden="true"></div>
  <div class="perspective-grid" aria-hidden="true"></div>
  <div class="noise" aria-hidden="true"></div>
  <div class="crt-overlay" aria-hidden="true"></div>

  <!-- NAV -->
  <header class="nav">
    <div class="nav-inner">
      <div class="nav-content">
        <a class="logo-pill" href={`/${lang}`}>
          <span class="logo-dot"></span>
          <span>{personalInfo.name.toUpperCase()}</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href="#services">{t.nav.services}</a>
          <a href="#process">{t.nav.process}</a>
          <a href="#contact">{t.nav.contact}</a>
          
        </nav>
        <div class="nav-cta">
          <a class="btn-neon" href="#contact">
            <span class="dot"></span>
            <span>{t.nav.startProject}</span>
          </a>
          <div class="theme-switch" role="group" aria-label="Theme switcher">
            <span class="theme-label">Theme</span>
            <button class="switch-btn" id="themeToggle" type="button" aria-label="Toggle theme">AURORA</button>
          </div>
          <div class="lang-dropdown-wrap">
            <button class="lang-toggle-btn" id="langToggle" type="button" aria-label="Switch language">
              <span>{langLabels[lang]?.label}</span>
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="lang-dropdown" id="langDropdown">
              {Object.entries(langLabels).map(([code, { label, flag }]) => (
                <a
                  href={`/${code}/services`}
                  class={`lang-option${lang === code ? ' active' : ''}`}
                >
                  <span style="font-size:1.1rem;line-height:1;">{flag}</span>
