          <div class="terminal-body" id="terminal-body">
            <span class="terminal-line"><span class="prefix">$</span> <span class="command">services.list</span></span>
            <span class="terminal-line"><span class="output">{t.terminalList}</span></span>
            <div id="terminal-log"></div>
            <div class="terminal-prompt" style="flex-shrink:0">
              <span class="prefix">$</span>
              <span class="terminal-input" id="terminal-input"></span>
              <span class="terminal-cursor" aria-hidden="true"></span>
