    hero: {
      subtitle: 'Desarrollador Web Freelance / Estudio de Servicios',
      titleAccent: 'Creo, corrijo & hago evolucionar',
      titleRest: 'sitios que convierten.',
      desc1: '¿Necesitas un', new_website: 'nuevo sitio web', desc2: ', correcciones urgentes de', bug_fixes: 'errores', desc3: ', o un dev para',
      maintain: 'mantener & mejorar', desc4: 'lo que ya tienes? Ayudo a pequeñas empresas, fundadores independientes y agencias a mantener sus sitios rápidos, estables y efectivos.',
      tags: ['Creación de sitios', 'Debug & rescate', 'Planes de mantenimiento', 'Evolución continua'],
      viewServices: 'Ver servicios', bookCall: 'Reservar una llamada',
      metaLaunch: 'Lanzar', metaLaunchRest: 'nuevos sitios',
      metaFix: 'Corregir', metaFixRest: 'los problemas',
      metaMaintain: 'Mantener', metaMaintainRest: 'a largo plazo',
