    footer: 'Services',
    terminalList: '[ new-site ] [ debug ] [ maintain ] [ evolve ]',
    terminalCommands: [
      { input: 'new-site', output: ['→ custom website or redesign, no generic template.', 'includes structure, design, build and launch support.'] },
