  </main>

  <footer>
    <div class="footer-inner">
      <span>{personalInfo.name} · {t.footer}</span>
      <span>Vanilla HTML / CSS / JS</span>
    </div>
  </footer>

  <script id="terminal-commands-data" type="application/json" set:html={JSON.stringify(t.terminalCommands)}></script>
  <script id="contact-i18n-data" type="application/json"
    data-worker-url={import.meta.env.PUBLIC_CONTACT_WORKER_URL ?? ''}
    set:html={JSON.stringify({ sending: t.contact.sending, success: t.contact.success, error: t.contact.error })}></script>

  <style is:global>
    .terminal-line {
      display: block;
      margin-bottom: 4px;
      line-height: 1.5;
    }
    .terminal-line .prefix { color: var(--term-prefix); }
    .terminal-line .command { color: var(--term-command); font-weight: 700; }
    .terminal-line .output { color: var(--term-output); }
    #terminal-log { display: flex; flex-direction: column; }
  </style>

  <script>
    // Theme toggle
    const root = document.documentElement;
    const btn = document.getElementById('themeToggle');

    const themes = ['aurora', 'cyberpunk', 'synthwave'] as const;
    type ThemeName = typeof themes[number];

    const themeLabels: Record<ThemeName, string> = {
      aurora: 'AURORA',
      cyberpunk: 'CYBERPUNK',
      synthwave: 'SYNTHWAVE',
    };

    function isTheme(value: string | null): value is ThemeName {
      return value !== null && themes.includes(value as ThemeName);
    }

    function setTheme(theme: ThemeName) {
      root.setAttribute('data-theme', theme);
      localStorage.setItem('srvTheme', theme);

      if (btn) {
        btn.textContent = themeLabels[theme];
        btn.setAttribute('aria-label', `Current theme: ${themeLabels[theme]}`);
      }
    }

    const saved = localStorage.getItem('srvTheme');

    if (isTheme(saved)) {
      setTheme(saved);
    } else {
      setTheme('aurora');
    }

    btn?.addEventListener('click', () => {
      const current = root.getAttribute('data-theme');

      const currentIndex = isTheme(current)
        ? themes.indexOf(current)
        : 0;

      const nextTheme = themes[(currentIndex + 1) % themes.length];

      setTheme(nextTheme);
    });

    // Smooth scroll
    document.querySelectorAll('[href^="#"]').forEach(el => {
      el.addEventListener('click', e => {
        const href = (el as HTMLAnchorElement).getAttribute('href');
        if (!href) return;
        const target = document.querySelector(href);
        if (!target) return;
        e.preventDefault();
        window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - 86, behavior: 'smooth' });
      });
    });

    // Terminal animation
    const terminalLog = document.getElementById('terminal-log');
    const terminalInput = document.getElementById('terminal-input');
    const commandsEl = document.getElementById('terminal-commands-data');
    const commands = JSON.parse(commandsEl?.textContent ?? '[]');
    let cmdIdx = 0, phase = 'typingInput', charIdx = 0;

    function appendLine(text: string, type: string) {
      if (!terminalLog) return;
      const line = document.createElement('span');
      line.className = 'terminal-line';
      line.innerHTML = type === 'input'
        ? `<span class="prefix">$</span> <span class="command">${text}</span>`
        : `<span class="output">${text}</span>`;
      terminalLog.appendChild(line);
      const body = document.getElementById('terminal-body');
      if (body) body.scrollTop = body.scrollHeight;
    }

    function step() {
      const cmd = commands[cmdIdx];
      if (phase === 'typingInput') {
        if (charIdx <= cmd.input.length) { if (terminalInput) terminalInput.textContent = cmd.input.slice(0, charIdx++); setTimeout(step, 85); }
        else { appendLine(cmd.input, 'input'); if (terminalInput) terminalInput.textContent = ''; phase = 'showingOutput'; charIdx = 0; setTimeout(step, 280); }
      } else if (phase === 'showingOutput') {
        if (charIdx < cmd.output.length) { appendLine(cmd.output[charIdx++], 'output'); setTimeout(step, 420); }
        else { phase = 'idle'; charIdx = 0; setTimeout(step, 1900); }
      } else { cmdIdx = (cmdIdx + 1) % commands.length; phase = 'typingInput'; charIdx = 0; setTimeout(step, 520); }
    }
    step();

    // language dropdown toggle
    const langToggle = document.getElementById('langToggle');
    const langDropdown = document.getElementById('langDropdown');
    if (langToggle && langDropdown) {
      langToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        langDropdown.classList.toggle('open');
      });
      document.addEventListener('click', () => langDropdown.classList.remove('open'));
    }

    // header animation on scroll
    const nav = document.querySelector('.nav');

    function updateNavPosition() {
      if (!nav) return;

      if (window.scrollY > 20) {
        nav.classList.add('is-scrolled');
      } else {
        nav.classList.remove('is-scrolled');
      }
    }

    window.addEventListener('scroll', updateNavPosition);
    updateNavPosition();

    // Contact form - ready for Resend / backend hookup
    document.getElementById('contactForm')?.addEventListener('focusin', () => {
      if (!sessionStorage.getItem('_cft')) sessionStorage.setItem('_cft', String(Date.now()));
    }, { once: true });

    document.getElementById('contactForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
      const status = document.getElementById('formStatus') as HTMLElement | null;
      const data = Object.fromEntries(new FormData(form));

      if (submitBtn) { submitBtn.style.opacity = '0.6'; submitBtn.style.pointerEvents = 'none'; }
      if (status) { status.style.display = 'block'; status.style.color = 'var(--muted)'; }
      const i18nEl = document.getElementById('contact-i18n-data');
      const i18n = JSON.parse(i18nEl?.textContent ?? '{}');
      if (status) status.textContent = i18n.sending;

      const WORKER_URL = (document.getElementById('contact-i18n-data') as HTMLElement & { dataset: DOMStringMap })?.dataset?.workerUrl ?? '';
      try {
        const res = await fetch(WORKER_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, _t: Number(sessionStorage.getItem('_cft') || Date.now()) })
        });
        if (!res.ok) throw new Error('Server error');
        if (status) { status.style.color = 'var(--primary)'; status.textContent = i18n.success; }
        form.reset();
      } catch {
        if (status) { status.style.color = '#ff6b6b'; status.textContent = i18n.error; }
      } finally {
        if (submitBtn) { submitBtn.style.opacity = '1'; submitBtn.style.pointerEvents = 'auto'; }
      }
    });
  </script>
</body>
</html>
