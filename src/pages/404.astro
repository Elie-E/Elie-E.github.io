    subtitle: 'La page que vous recherchez n\'existe pas.',
    description: 'La page demandée a peut-être été déplacée, supprimée, ou vous avez peut-être saisi une URL incorrecte.',
    suggestions: 'Voici quelques suggestions :',
    suggestionsList: [
      'Vérifiez l\'URL pour les fautes de frappe',
      'Retournez à la page précédente',
      'Visitez notre page d\'accueil',
      'Utilisez le menu de navigation ci-dessus'
    ],
    backHome: 'Retour à l\'Accueil',
    contactUs: 'Contact',
