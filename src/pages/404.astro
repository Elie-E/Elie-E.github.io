  },
  es: {
    title: '¡Ups! Estás perdido',
    subtitle: 'La página que buscas no existe.',
    description: 'La página solicitada podría haber sido movida, eliminada, o podrías haber ingresado una URL incorrecta.',
    suggestions: 'Aquí tienes algunas sugerencias:',
    suggestionsList: [
      'Verifica la URL en busca de errores tipográficos',
      'Regresa a la página anterior',
      'Visita nuestra página de inicio',
      'Usa el menú de navegación de arriba'
    ],
    backHome: 'Volver al Inicio',
    contactUs: 'Contacto',
    searchPlaceholder: 'Buscar en nuestro sitio...'
  },
  de: {
    title: 'Ups! Du bist verloren',
    subtitle: 'Die gesuchte Seite existiert nicht.',
    description: 'Die angeforderte Seite wurde möglicherweise verschoben, gelöscht oder Sie haben eine falsche URL eingegeben.',
    suggestions: 'Hier sind einige Vorschläge:',
    suggestionsList: [
      'Überprüfen Sie die URL auf Tippfehler',
      'Gehen Sie zur vorherigen Seite zurück',
      'Besuchen Sie unsere Startseite',
      'Verwenden Sie das Navigationsmenü oben'
    ],
    backHome: 'Zurück zur Startseite',
    contactUs: 'Kontakt',
    searchPlaceholder: 'Unsere Website durchsuchen...'
  },
  pt: {
    title: 'Página Não Encontrada',
    subtitle: 'Ops! A página que você está procurando não existe.',
    description: 'A página solicitada pode ter sido movida, excluída ou você pode ter inserido uma URL incorreta.',
    suggestions: 'Aqui estão algumas sugestões:',
    suggestionsList: [
      'Verifique a URL em busca de erros de digitação',
      'Volte para a página anterior',
      'Visite nossa página inicial',
      'Use o menu de navegação acima'
    ],
    backHome: 'Voltar ao Início',
    contactUs: 'Entre em Contato',
    searchPlaceholder: 'Pesquisar em nosso site...'
  },
  ja: {
    title: 'ページが見つかりません',
    subtitle: 'おっと！お探しのページは存在しません。',
    description: 'リクエストされたページは移動、削除されたか、間違ったURLを入力した可能性があります。',
    suggestions: '以下をご提案します：',
    suggestionsList: [
      'URLのタイプミスを確認してください',
      '前のページに戻ってください',
      'ホームページをご覧ください',
