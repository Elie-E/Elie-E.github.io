---
import { languages } from '../types/index.js';
import { getPersonalInfo } from '../data/index.js';

export interface Props {
  currentLang: string;
  currentPath: string;
}

const { currentLang, currentPath } = Astro.props;
const personalInfo = getPersonalInfo(currentLang);

// Navigation items with translations
const navItems = {
  fr: { home: 'Accueil', resume: 'CV', portfolio: 'Portfolio', blog: 'Blog', about: 'À propos', recommendations: 'Recommandations', contact: 'Contact' },
  en: { home: 'Home', resume: 'Resume', portfolio: 'Portfolio', blog: 'Blog', about: 'About', recommendations: 'Recommendations', contact: 'Contact' },
  es: { home: 'Inicio', resume: 'Currículum', portfolio: 'Portafolio', blog: 'Blog', about: 'Acerca de', recommendations: 'Recomendaciones', contact: 'Contacto' },
  de: { home: 'Startseite', resume: 'Lebenslauf', portfolio: 'Portfolio', blog: 'Blog', about: 'Über mich', recommendations: 'Empfehlungen', contact: 'Kontakt' },
  pt: { home: 'Início', resume: 'Currículo', portfolio: 'Portfólio', blog: 'Blog', about: 'Sobre', recommendations: 'Recomendações', contact: 'Contato' },
  ja: { home: 'ホーム', resume: '履歴書', portfolio: 'ポートフォリオ', blog: 'ブログ', about: 'について', recommendations: '推薦', contact: 'お問い合わせ' },
  ko: { home: '홈', resume: '이력서', portfolio: '포트폴리오', blog: '블로그', about: '소개', recommendations: '추천', contact: '연락처' },
  zh: { home: '首页', resume: '简历', portfolio: '作品集', blog: '博客', about: '关于', recommendations: '推荐', contact: '联系' },
  ar: { home: 'الرئيسية', resume: 'السيرة الذاتية', portfolio: 'المحفظة', blog: 'المدونة', about: 'حول', recommendations: 'التوصيات', contact: 'اتصل' }
};

const currentNav = navItems[currentLang as keyof typeof navItems] || navItems.en;
---

<header class="bg-white/80 backdrop-blur-md shadow-lg border-b border-blue-100 sticky top-0 z-40">
  <div class="container mx-auto px-6">
    <div class="flex items-center justify-between h-20">
      <!-- Logo/Brand -->
      <div class="flex items-center">
        <a href={`/${currentLang}`} class="text-2xl font-bold bg-gradient-to-r from-blue-600 to-blue-800 bg-clip-text text-transparent hover:from-blue-700 hover:to-blue-900 transition-all duration-300">
          {personalInfo.name}
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-1">
        <a 
          href={`/${currentLang}`} 
          class={`px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${
            currentPath === `/${currentLang}` || currentPath === `/${currentLang}/`
              ? 'bg-blue-600 text-white shadow-lg shadow-blue-200'
              : 'text-gray-600 hover:text-blue-600 hover:bg-blue-50'
          }`}
        >
          {currentNav.home}
        </a>
        <a 
          href={`/${currentLang}/resume/`} 
          class={`px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${
            currentPath === `/${currentLang}/resume`
              ? 'bg-blue-600 text-white shadow-lg shadow-blue-200'
              : 'text-gray-600 hover:text-blue-600 hover:bg-blue-50'
          }`}
        >
          {currentNav.resume}
        </a>
        <a 
          href={`/${currentLang}/portfolio/`} 
          class={`px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${
            currentPath === `/${currentLang}/portfolio`
              ? 'bg-blue-600 text-white shadow-lg shadow-blue-200'
              : 'text-gray-600 hover:text-blue-600 hover:bg-blue-50'
          }`}
        >
          {currentNav.portfolio}
        </a>
        <a 
          href={`/${currentLang}/recommendations/`} 
          class={`px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${
            currentPath === `/${currentLang}/recommendations`
              ? 'bg-blue-600 text-white shadow-lg shadow-blue-200'
              : 'text-gray-600 hover:text-blue-600 hover:bg-blue-50'
          }`}
        >
          {currentNav.recommendations}
        </a>
        <a 
          href={`/${currentLang}/blog/`} 
          class={`px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${
            currentPath === `/${currentLang}/blog`
              ? 'bg-blue-600 text-white shadow-lg shadow-blue-200'
              : 'text-gray-600 hover:text-blue-600 hover:bg-blue-50'
          }`}
        >
          {currentNav.blog}
        </a>
        <a 
          href={`/${currentLang}/about/`} 
          class={`px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${
            currentPath === `/${currentLang}/about`
              ? 'bg-blue-600 text-white shadow-lg shadow-blue-200'
              : 'text-gray-600 hover:text-blue-600 hover:bg-blue-50'
          }`}
        >
          {currentNav.about}
        </a>
        <a 
          href={`/${currentLang}/contact/`} 
          class={`px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${
            currentPath === `/${currentLang}/contact`
              ? 'bg-blue-600 text-white shadow-lg shadow-blue-200'
              : 'text-gray-600 hover:text-blue-600 hover:bg-blue-50'
          }`}
        >
          {currentNav.contact}
        </a>
      </nav>

      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button 
          id="mobile-menu-button"
          class="text-gray-600 hover:text-blue-600 focus:outline-none focus:text-blue-600 p-2 rounded-lg hover:bg-blue-50 transition-all duration-200"
          aria-label="Toggle mobile menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="md:hidden hidden">
      <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3 border-t border-blue-100">
        <a 
          href={`/${currentLang}`} 
          class={`block px-3 py-2 rounded-lg text-base font-medium transition-all duration-200 ${
            currentPath === `/${currentLang}` || currentPath === `/${currentLang}/`
              ? 'bg-blue-600 text-white shadow-lg shadow-blue-200'
              : 'text-gray-600 hover:text-blue-600 hover:bg-blue-50'
          }`}
        >
          {currentNav.home}
        </a>
        <a 
          href={`/${currentLang}/resume/`} 
          class={`block px-3 py-2 rounded-lg text-base font-medium transition-all duration-200 ${
            currentPath === `/${currentLang}/resume`
              ? 'bg-blue-600 text-white shadow-lg shadow-blue-200'
              : 'text-gray-600 hover:text-blue-600 hover:bg-blue-50'
          }`}
        >
          {currentNav.resume}
        </a>
        <a 
          href={`/${currentLang}/portfolio/`} 
          class={`block px-3 py-2 rounded-lg text-base font-medium transition-all duration-200 ${
            currentPath === `/${currentLang}/portfolio`
              ? 'bg-blue-600 text-white shadow-lg shadow-blue-200'
              : 'text-gray-600 hover:text-blue-600 hover:bg-blue-50'
          }`}
        >
          {currentNav.portfolio}
        </a>
        <a 
          href={`/${currentLang}/recommendations/`} 
          class={`block px-3 py-2 rounded-lg text-base font-medium transition-all duration-200 ${
            currentPath === `/${currentLang}/recommendations`
              ? 'bg-blue-600 text-white shadow-lg shadow-blue-200'
              : 'text-gray-600 hover:text-blue-600 hover:bg-blue-50'
          }`}
        >
          {currentNav.recommendations}
        </a>
        <a 
          href={`/${currentLang}/blog/`} 
          class={`block px-3 py-2 rounded-lg text-base font-medium transition-all duration-200 ${
            currentPath === `/${currentLang}/blog`
              ? 'bg-blue-600 text-white shadow-lg shadow-blue-200'
              : 'text-gray-600 hover:text-blue-600 hover:bg-blue-50'
          }`}
        >
          {currentNav.blog}
        </a>
        <a 
          href={`/${currentLang}/about/`} 
          class={`block px-3 py-2 rounded-lg text-base font-medium transition-all duration-200 ${
            currentPath === `/${currentLang}/about`
              ? 'bg-blue-600 text-white shadow-lg shadow-blue-200'
              : 'text-gray-600 hover:text-blue-600 hover:bg-blue-50'
          }`}
        >
          {currentNav.about}
        </a>
        <a 
          href={`/${currentLang}/contact/`} 
          class={`block px-3 py-2 rounded-lg text-base font-medium transition-all duration-200 ${
            currentPath === `/${currentLang}/contact`
              ? 'bg-blue-600 text-white shadow-lg shadow-blue-200'
              : 'text-gray-600 hover:text-blue-600 hover:bg-blue-50'
          }`}
        >
          {currentNav.contact}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Optimized mobile menu with reduced JavaScript
  document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    
    if (mobileMenuButton && mobileMenu) {
      // Simplified event handling
      mobileMenuButton.addEventListener('click', (e) => {
        e.stopPropagation();
        mobileMenu.classList.toggle('hidden');
      });
      
      // Close mobile menu when clicking on a link
      const mobileLinks = mobileMenu.querySelectorAll('a');
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          setTimeout(() => mobileMenu.classList.add('hidden'), 100);
        });
      });
      
      // Close mobile menu when clicking outside
      document.addEventListener('click', (e) => {
        if (!mobileMenuButton.contains(e.target) && !mobileMenu.contains(e.target)) {
          mobileMenu.classList.add('hidden');
        }
      });
    }
  });
</script>
