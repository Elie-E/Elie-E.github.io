---
import { getTestimonials } from '../data/index.js';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const testimonials = getTestimonials(lang);

// Carousel translations
const carouselTranslations = {
  fr: {
    title: 'Recommandations Clients',
    subtitle: 'Ce que disent mes clients et partenaires',
    viewAll: 'Voir toutes les recommandations',
    clientSince: 'Client depuis',
    viewTestimonial: 'Voir la recommandation'
  },
  en: {
    title: 'Client Recommendations',
    subtitle: 'What my clients and partners say',
    viewAll: 'View all recommendations',
    clientSince: 'Client since',
    viewTestimonial: 'View recommendation'
  },
  es: {
    title: 'Recomendaciones de Clientes',
    subtitle: 'Lo que dicen mis clientes y socios',
    viewAll: 'Ver todas las recomendaciones',
    clientSince: 'Cliente desde',
    viewTestimonial: 'Ver recomendación'
  },
  de: {
    title: 'Kundenempfehlungen',
    subtitle: 'Was meine Kunden und Partner sagen',
    viewAll: 'Alle Empfehlungen anzeigen',
    clientSince: 'Kunde seit',
    viewTestimonial: 'Empfehlung anzeigen'
  },
  pt: {
    title: 'Recomendações de Clientes',
    subtitle: 'O que dizem meus clientes e parceiros',
    viewAll: 'Ver todas as recomendações',
    clientSince: 'Cliente desde',
    viewTestimonial: 'Ver recomendação'
  },
  ja: {
    title: 'クライアント推薦',
    subtitle: 'クライアントとパートナーからの評価',
    viewAll: 'すべての推薦を見る',
    clientSince: 'クライアント開始',
    viewTestimonial: '推薦を見る'
  },
  ko: {
    title: '고객 추천',
    subtitle: '고객과 파트너들의 평가',
    viewAll: '모든 추천 보기',
    clientSince: '고객 시작',
    viewTestimonial: '추천 보기'
  },
  zh: {
    title: '客户推荐',
    subtitle: '客户和合作伙伴的评价',
    viewAll: '查看所有推荐',
    clientSince: '客户开始',
    viewTestimonial: '查看推荐'
  },
  ar: {
    title: 'توصيات العملاء',
    subtitle: 'ما يقوله عملائي وشركائي',
    viewAll: 'عرض جميع التوصيات',
    clientSince: 'عميل منذ',
    viewTestimonial: 'عرض التوصية'
  }
};

const t = carouselTranslations[lang as keyof typeof carouselTranslations] || carouselTranslations.en;
---

<section class="py-12 bg-gradient-to-r from-blue-50 to-purple-50">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-8">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">{t.title}</h2>
        <p class="text-gray-600">{t.subtitle}</p>
      </div>

      <!-- Carousel Container -->
      <div class="relative">
        <div class="testimonials-carousel overflow-hidden" data-testimonials={JSON.stringify(testimonials)}>
          <div class="testimonials-track flex transition-transform duration-500 ease-in-out">
            {testimonials.map((testimonial, index) => (
              <div class="testimonial-slide flex-shrink-0 w-full px-4">
                <div class="bg-white rounded-xl shadow-lg p-6 mx-auto max-w-2xl">
                  <!-- Client Info -->
                  <div class="flex items-center gap-4 mb-4">
                    <img src={testimonial.image} alt={testimonial.name} class="w-12 h-12 rounded-full object-cover border-2 border-blue-200"/>
                    <div>
                      <h3 class="font-semibold">{testimonial.name}</h3>
                      <p class="text-sm text-gray-600">{testimonial.role}</p>
                      <p class="text-sm text-blue-600 font-medium">{testimonial.company}</p>
                    </div>
                    <div class="ml-auto text-right">
                      <div class="flex mb-1">
                        {Array.from({length: testimonial.rating}).map(() => (
                          <svg class="w-4 h-4 text-yellow-400 fill-current" viewBox="0 0 20 20">
                            <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                          </svg>
                        ))}
                      </div>
                      <p class="text-xs text-gray-500">{t.clientSince} {testimonial.clientSince}</p>
                    </div>
                  </div>
                  
                  <!-- Testimonial Content -->
                  <div class="relative mb-4">
                    <svg class="absolute -top-1 -left-1 w-6 h-6 text-blue-200" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h4v10h-10z"/>
                    </svg>
                    <blockquote class="text-gray-700 pl-6 italic">
                      "{testimonial.testimonial}"
                    </blockquote>
                  </div>
                  
                  <!-- Action Button -->
                  <div class="text-center">
                    <a href={`/${lang}/recommendations#${testimonial.id}`} 
                       class="inline-block px-4 py-2 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-lg hover:from-blue-700 hover:to-purple-700 transition-all duration-300 text-sm">
                      {t.viewTestimonial}
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Navigation Dots -->
        <div class="flex justify-center mt-6 space-x-3">
          {testimonials.map((_, index) => (
            <button class={`testimonial-dot w-4 h-4 rounded-full transition-colors duration-300 ${index === 0 ? 'bg-blue-600' : 'bg-gray-300'}`} 
                    data-index={index}
                    aria-label={`Aller au témoignage ${index + 1}`}
                    title={`Témoignage ${index + 1}`}></button>
          ))}
        </div>
        
        <!-- View All Button -->
        <div class="text-center mt-6">
          <a href={`/${lang}/recommendations`} class="inline-flex items-center gap-2 px-4 py-2 text-blue-600 hover:text-blue-700 font-medium transition-colors border border-blue-200 hover:border-blue-300 rounded-lg hover:bg-blue-50">
            <span>{t.viewAll}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
        
        <!-- Navigation Arrows -->
        <button class="testimonial-prev absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 w-10 h-10 bg-white rounded-full shadow-lg flex items-center justify-center hover:bg-gray-50 transition-colors">
          <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button class="testimonial-next absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 w-10 h-10 bg-white rounded-full shadow-lg flex items-center justify-center hover:bg-gray-50 transition-colors">
          <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  // Testimonials Carousel JavaScript
  document.addEventListener('DOMContentLoaded', function() {
    const carousel = document.querySelector('.testimonials-carousel');
    if (!carousel) return;
    
    const track = carousel.querySelector('.testimonials-track');
    const slides = carousel.querySelectorAll('.testimonial-slide');
    const dots = document.querySelectorAll('.testimonial-dot');
    const prevBtn = document.querySelector('.testimonial-prev');
    const nextBtn = document.querySelector('.testimonial-next');
    
    let currentIndex = 0;
    const totalSlides = slides.length;
    
    // Auto-advance interval (5 seconds)
    let autoAdvanceInterval;
    
    function updateCarousel() {
      const translateX = -currentIndex * 100;
      track.style.transform = `translateX(${translateX}%)`;
      
      // Update dots
      dots.forEach((dot, index) => {
        dot.classList.toggle('bg-blue-600', index === currentIndex);
        dot.classList.toggle('bg-gray-300', index !== currentIndex);
      });
    }
    
    function nextSlide() {
      currentIndex = (currentIndex + 1) % totalSlides;
      updateCarousel();
    }
    
    function prevSlide() {
      currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
      updateCarousel();
    }
    
    function goToSlide(index) {
      currentIndex = index;
      updateCarousel();
    }
    
    function startAutoAdvance() {
      autoAdvanceInterval = setInterval(nextSlide, 5000);
    }
    
    function stopAutoAdvance() {
      clearInterval(autoAdvanceInterval);
    }
    
    // Event listeners
    nextBtn?.addEventListener('click', () => {
      stopAutoAdvance();
      nextSlide();
      startAutoAdvance();
    });
    
    prevBtn?.addEventListener('click', () => {
      stopAutoAdvance();
      prevSlide();
      startAutoAdvance();
    });
    
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        stopAutoAdvance();
        goToSlide(index);
        startAutoAdvance();
      });
    });
    
    // Pause on hover
    carousel.addEventListener('mouseenter', stopAutoAdvance);
    carousel.addEventListener('mouseleave', startAutoAdvance);
    
    // Start auto-advance
    startAutoAdvance();
    
    // Touch/swipe support for mobile
    let touchStartX = 0;
    let touchEndX = 0;
    
    carousel.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAutoAdvance();
    });
    
    carousel.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
      startAutoAdvance();
    });
    
    function handleSwipe() {
      const swipeThreshold = 50;
      const diff = touchStartX - touchEndX;
      
      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0) {
          nextSlide(); // Swipe left - next slide
        } else {
          prevSlide(); // Swipe right - previous slide
        }
      }
    }
  });
</script>

<style>
  .testimonials-carousel {
    position: relative;
  }
  
  @media (max-width: 768px) {
    .testimonial-prev,
    .testimonial-next {
      display: none;
    }
  }
</style>
