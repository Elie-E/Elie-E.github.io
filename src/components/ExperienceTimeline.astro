---
import { getExperiences, getExperiencesDev } from '../data';

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const experiences = getExperiencesDev(lang);

// Translations
const translations = {
  en: {
    title: 'Professional Experience',
    subtitle: 'A practical path to full-stack development',
    labels: {
      duration: 'Duration',
      type: 'Type',
      location: 'Location',
      technologies: 'Technologies',
      relevantSkills: 'Relevant skills'
    },
    types: {
      CDI: 'Full-time',
      Freelance: 'Freelance',
      Stage: 'Internship',
      Internship: 'Internship',
      'Full-time': 'Full-time'
    },
    present: 'Present',
    summary: {
      title: 'A business-oriented full-stack developer',
      description: 'I bring together 4+ years of professional web development experience with a previous background in project management, team coordination and entrepreneurship.',
      skills: ['Full-Stack Development', 'Project Management', 'Team Coordination', 'Business Understanding']
    }
  },
  fr: {
    title: 'Expérience Professionnelle',
    subtitle: 'Un parcours pragmatique vers le développement full-stack',
    labels: {
      duration: 'Durée',
      type: 'Type',
      location: 'Localisation',
      technologies: 'Technologies',
      relevantSkills: 'Compétences associées'
    },
    types: {
      CDI: 'CDI',
      Freelance: 'Freelance',
      Stage: 'Stage',
      Internship: 'Stage',
      'Full-time': 'CDI'
    },
    present: 'Présent',
    summary: {
      title: 'Un développeur full-stack orienté business',
      description: 'Je combine plus de 4 ans d\'expérience en développement web avec un parcours en gestion de projet, management d\'équipe et entrepreneuriat.',
      skills: ['Développement Full-Stack', 'Gestion de Projet', 'Coordination d\'Équipe', 'Compréhension Métier']
    }
  },
  es: {
    title: 'Experiencia Profesional',
    subtitle: 'Un camino práctico hacia el desarrollo full-stack',
    labels: {
      duration: 'Duración',
      type: 'Tipo',
      location: 'Ubicación',
      technologies: 'Tecnologías',
      relevantSkills: 'Habilidades relevantes'
    },
    types: {
      CDI: 'Tiempo completo',
      Freelance: 'Freelance',
      Stage: 'Prácticas',
      Internship: 'Prácticas',
      'Full-time': 'Tiempo completo'
    },
    present: 'Presente',
    summary: {
      title: 'Un desarrollador full-stack orientado al negocio',
      description: 'Combino más de 4 años de experiencia en desarrollo web profesional con un historial en gestión de proyectos, coordinación de equipos y emprendimiento.',
      skills: ['Desarrollo Full-Stack', 'Gestión de Proyectos', 'Coordinación de Equipos', 'Comprensión del Negocio']
    }
  }
};

const t = translations[lang as keyof typeof translations] || translations.en;

// Format date for display
function formatDate(dateStr: string, language: string = 'en'): string {
  const [year, month] = dateStr.split('-');
  const monthNames: Record<string, string[]> = {
    en: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
    fr: ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'],
    es: ['ene.', 'feb.', 'mar.', 'abr.', 'may.', 'jun.', 'jul.', 'ago.', 'sep.', 'oct.', 'nov.', 'dic.'],
  };
  const months = monthNames[language] || monthNames.en;
  return `${months[parseInt(month) - 1]} ${year}`;
}

// Get type color
function getTypeColor(type: string): string {
  switch (type) {
    case 'CDI': return 'bg-blue-100 text-blue-700 border-blue-200';
    case 'Freelance': return 'bg-green-100 text-green-700 border-green-200';
    case 'Stage': return 'bg-purple-100 text-purple-700 border-purple-200';
    case 'Internship': return 'bg-purple-100 text-purple-700 border-purple-200';
    default: return 'bg-gray-100 text-gray-700 border-gray-200';
  }
}
---

<section class="py-20 bg-white">
  <div class="container mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold bg-gradient-to-r from-blue-600 to-cyan-600 bg-clip-text text-transparent mb-4">
        {t.title}
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        {t.subtitle}
      </p>
    </div>

    <!-- Experience Timeline -->
    <div class="relative max-w-4xl mx-auto">
      <!-- Timeline Line -->
      <div class="absolute left-8 top-0 bottom-0 w-1 bg-gradient-to-b from-blue-200 via-blue-400 to-cyan-400 rounded-full"></div>
      
      <!-- Experience Items -->
      <div class="space-y-8">
        {experiences.map((exp, index) => (
          <div class="relative flex items-start group">
            <!-- Timeline Dot -->
            <div class="relative z-10 flex items-center justify-center w-16 h-16 bg-white rounded-full shadow-lg border-4 border-blue-200 group-hover:border-blue-400 transition-all duration-300 group-hover:scale-110">
              <div class="w-8 h-8 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full flex items-center justify-center">
                <span class="text-white font-bold text-sm">{index + 1}</span>
              </div>
            </div>
            
            <!-- Experience Card -->
            <div class="ml-8 flex-1">
              <div class="bg-white/80 backdrop-blur-sm rounded-2xl p-8 shadow-lg border border-blue-100 hover:shadow-xl transition-all duration-300 group-hover:translate-x-2">
                <!-- Header -->
                <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-4">
                  <div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-1 group-hover:text-blue-600 transition-colors duration-300">
                      {exp.position}
                    </h3>
                    <h4 class="text-xl font-semibold text-blue-600 mb-2">
                      {exp.company}
                    </h4>
                  </div>
                  <div class="flex flex-wrap gap-2 mb-4 md:mb-0">
                    {exp.technologies.length > 0 && (
                      <span class={`px-3 py-1 rounded-full text-sm font-medium border ${getTypeColor(exp.type)}`}>
                        {t.types[exp.type as keyof typeof t.types]}
                      </span>
                    )}
                    <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium border border-gray-200">
                      {exp.duration}
                    </span>
                  </div>
                </div>

                <!-- Date and Location -->
                <div class="flex flex-col md:flex-row md:items-center gap-4 mb-4 text-sm text-gray-600">
                  <div class="flex items-center">
                    <svg class="w-4 h-4 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    <span>
                      {formatDate(exp.startDate, lang)}
                      {exp.endDate ? ` - ${formatDate(exp.endDate, lang)}` : ` – ${t.present}`}
                    </span>
                  </div>
                  <div class="flex items-center">
                    <svg class="w-4 h-4 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span>{exp.location}</span>
                  </div>
                </div>

                <!-- Description -->
                <p class="text-gray-700 leading-relaxed mb-6">
                  {exp.description}
                </p>

                <!-- Technologies / Relevant Skills -->
                {exp.technologies.length > 0 && (
                  <div>
                    <h5 class="text-sm font-semibold text-gray-600 mb-3">{t.labels.technologies}</h5>
                    <div class="flex flex-wrap gap-2">
                      {exp.technologies.map((tech) => (
                        <span class="px-3 py-1 bg-blue-50 text-blue-700 rounded-lg text-sm font-medium border border-blue-200 hover:bg-blue-100 transition-colors duration-200">
                          {tech}
                        </span>
                      ))}
                    </div>
                  </div>
                )}
                {exp.technologies.length === 0 && (exp.achievements ?? []).length > 0 && (
                  <div>
                    <h5 class="text-sm font-semibold text-gray-600 mb-3">{t.labels.relevantSkills}</h5>
                    <div class="flex flex-wrap gap-2">
                      {(exp.achievements ?? []).map((skill) => (
                        <span class="px-3 py-1 bg-gray-50 text-gray-700 rounded-lg text-sm font-medium border border-gray-200">
                          {skill}
                        </span>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Summary -->
    <div class="mt-16 text-center">
      <div class="bg-gradient-to-r from-blue-50 to-cyan-50 rounded-2xl p-8 border border-blue-200 max-w-4xl mx-auto">
        <h3 class="text-2xl font-bold text-gray-900 mb-4">
          {t.summary.title}
        </h3>
        <div class="flex flex-wrap justify-center gap-4">
          {t.summary.skills.map(skill => (
            <span class="px-4 py-2 bg-blue-100 text-blue-700 rounded-full text-sm font-medium">
              {skill}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Custom animations for timeline */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .timeline-item {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  .timeline-item:nth-child(1) { animation-delay: 0.1s; }
  .timeline-item:nth-child(2) { animation-delay: 0.2s; }
  .timeline-item:nth-child(3) { animation-delay: 0.3s; }
  .timeline-item:nth-child(4) { animation-delay: 0.4s; }
  .timeline-item:nth-child(5) { animation-delay: 0.5s; }
  .timeline-item:nth-child(6) { animation-delay: 0.6s; }
  .timeline-item:nth-child(7) { animation-delay: 0.7s; }
  .timeline-item:nth-child(8) { animation-delay: 0.8s; }
  .timeline-item:nth-child(9) { animation-delay: 0.9s; }
</style>
