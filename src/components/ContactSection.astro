---
import { getContactInfo } from '../data/index.js';

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const contactInfo = getContactInfo();

// Translations
const translations = {
  fr: {
    title: 'Contact',
    subtitle: 'Comment je peux aider',
    cards: [
      { title: 'Missions courtes', description: 'Corrections de bugs, petites fonctionnalités, intégrations, landing pages.' },
      { title: 'Collaboration longue durée', description: 'Maintenance, support en production, améliorations itératives.' },
      { title: 'Profil orienté business', description: 'Exécution technique avec une compréhension métier et gestion de projet.' },
    ],
    cta: {
      title: 'Prêt à collaborer ?',
      subtitle: 'Discutons de votre prochain projet',
      button: 'LinkedIn',
      contactPage: 'Me contacter'
    },
    availability: 'Disponible pour de nouveaux projets'
  },
  en: {
    title: 'Contact',
    subtitle: 'How I can help',
    cards: [
      { title: 'Short missions', description: 'Bug fixes, small features, integrations, landing pages.' },
      { title: 'Long-term collaboration', description: 'Maintenance, production support, iterative improvements.' },
      { title: 'Business-focused profile', description: 'Technical execution with project management and product understanding.' },
    ],
    cta: {
      title: 'Ready to collaborate?',
      subtitle: 'Let\'s discuss your next project',
      button: 'LinkedIn',
      contactPage: 'Contact me'
    },
    availability: 'Available for new projects'
  },
  es: {
    title: 'Contacto',
    subtitle: 'Cómo puedo ayudar',
    cards: [
      { title: 'Misiones cortas', description: 'Corrección de bugs, pequeñas funcionalidades, integraciones, landing pages.' },
      { title: 'Colaboración a largo plazo', description: 'Mantenimiento, soporte en producción, mejoras iterativas.' },
      { title: 'Perfil orientado al negocio', description: 'Ejecución técnica con gestión de proyecto y comprensión del producto.' },
    ],
    cta: {
      title: '¿Listo para colaborar?',
      subtitle: 'Hablemos de tu próximo proyecto',
      button: 'LinkedIn',
      contactPage: 'Contactarme'
    },
    availability: 'Disponible para nuevos proyectos'
  },
};

const t = translations[lang as keyof typeof translations] || translations.en;
---

<section class="py-12 md:py-20 bg-gradient-to-br from-gray-900 via-blue-900 to-gray-900 text-white overflow-hidden">
  <div class="container mx-auto px-4 md:px-6 max-w-full">
    <!-- Section Header -->
    <div class="text-center mb-8 md:mb-16">
      <h2 class="text-2xl md:text-4xl font-bold bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent mb-3 md:mb-4">
        {t.title}
      </h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center">
      <!-- How I can help -->
      <div>
        <p class="text-xs uppercase tracking-widest text-blue-400 font-mono mb-4 text-center lg:text-left">{t.subtitle}</p>
        <div class="space-y-4">
          {t.cards.map((card, i) => {
            const icons = [
              /* lightning bolt */
              `<svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
              /* repeat/loop */
              `<svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`,
              /* briefcase */
              `<svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
            ];
            return (
              <div class="bg-white/10 backdrop-blur-sm rounded-xl p-5 border border-white/20 hover:bg-white/15 transition-all duration-300">
                <div class="flex items-start gap-4">
                  <div class="w-9 h-9 rounded-lg bg-white/10 flex items-center justify-center flex-shrink-0" set:html={icons[i]} />
                  <div>
                    <h3 class="text-base font-semibold text-white mb-1">{card.title}</h3>
                    <p class="text-sm text-gray-400 leading-relaxed">{card.description}</p>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Call to Action -->
      <div class="text-center lg:text-left">
        <div class="bg-white/10 backdrop-blur-sm rounded-xl md:rounded-2xl p-6 md:p-8 border border-white/20">
          <h3 class="text-xl md:text-3xl font-bold text-white mb-3 md:mb-4">
            {t.cta.title}
          </h3>
          <p class="text-sm md:text-lg text-gray-300 mb-6 md:mb-8">
            {t.cta.subtitle}
          </p>
          
          <!-- Contact Methods -->
          <div class="space-y-3 md:space-y-4 mb-6 md:mb-8">
            <a 
              href={contactInfo.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-700 hover:to-cyan-700 text-white font-semibold py-3 md:py-4 px-4 md:px-6 rounded-lg md:rounded-xl transition-all duration-300 hover:scale-[1.02] shadow-lg hover:shadow-xl"
            >
              <div class="flex items-center justify-center">
                <svg class="w-4 h-4 md:w-5 md:h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-sm md:text-base">{t.cta.button}</span>
              </div>
            </a>
            
            <a 
              href={`/${lang}/contact`}
              class="block w-full bg-white/20 hover:bg-white/30 text-white font-semibold py-3 md:py-4 px-4 md:px-6 rounded-lg md:rounded-xl transition-all duration-300 hover:scale-[1.02] border border-white/30"
            >
              <div class="flex items-center justify-center">
                <svg class="w-4 h-4 md:w-5 md:h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                <span class="text-sm md:text-base">{t.cta.contactPage}</span>
              </div>
            </a>
          </div>

          <!-- Availability Status -->
          <div class="flex items-center justify-center lg:justify-start">
            <div class="w-2 h-2 md:w-3 md:h-3 bg-green-400 rounded-full mr-2 md:mr-3 animate-pulse"></div>
            <span class="text-xs md:text-sm text-gray-300">
              {t.availability}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  window.copyToClipboard = function(text, button) {
    // Add click animation
    button.style.transform = 'scale(0.95)';
    button.style.transition = 'all 0.1s ease';
    
    setTimeout(() => {
      button.style.transform = 'scale(1)';
    }, 100);
    
    navigator.clipboard.writeText(text).then(() => {
      // Show success message with animation
      const originalText = button.textContent;
      const originalClasses = button.className;
      
      // Change button appearance
      button.textContent = 'Copié !';
      button.className = button.className.replace('bg-blue-600 hover:bg-blue-700', 'bg-green-600 hover:bg-green-700');
      
      // Add success animation
      button.style.transform = 'scale(1.05)';
      button.style.boxShadow = '0 0 20px rgba(34, 197, 94, 0.5)';
      
      setTimeout(() => {
        button.style.transform = 'scale(1)';
        button.style.boxShadow = '';
      }, 200);
      
      // Reset after 2 seconds
      setTimeout(() => {
        button.textContent = originalText;
        button.className = originalClasses;
        button.style.transform = 'scale(1)';
        button.style.boxShadow = '';
      }, 2000);
      
    }).catch(() => {
      // Fallback for older browsers
      const textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'fixed';
      textArea.style.left = '-999999px';
      textArea.style.top = '-999999px';
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      
      try {
        document.execCommand('copy');
        
        // Show success message for fallback
        const originalText = button.textContent;
        const originalClasses = button.className;
        
        button.textContent = 'Copié !';
        button.className = button.className.replace('bg-blue-600 hover:bg-blue-700', 'bg-green-600 hover:bg-green-700');
        
        // Add success animation
        button.style.transform = 'scale(1.05)';
        button.style.boxShadow = '0 0 20px rgba(34, 197, 94, 0.5)';
        
        setTimeout(() => {
          button.style.transform = 'scale(1)';
          button.style.boxShadow = '';
        }, 200);
        
        // Reset after 2 seconds
        setTimeout(() => {
          button.textContent = originalText;
          button.className = originalClasses;
          button.style.transform = 'scale(1)';
          button.style.boxShadow = '';
        }, 2000);
        
      } catch (err) {
        console.error('Failed to copy text: ', err);
        button.textContent = 'Erreur';
        button.className = button.className.replace('bg-blue-600 hover:bg-blue-700', 'bg-red-600 hover:bg-red-700');
        
        setTimeout(() => {
          button.textContent = originalText;
          button.className = originalClasses;
        }, 2000);
      }
      
      document.body.removeChild(textArea);
    });
  }
</script>
