              </div>
            </a>
            
            <a 
              href={contactInfo.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full bg-white/20 hover:bg-white/30 text-white font-semibold py-3 md:py-4 px-4 md:px-6 rounded-lg md:rounded-xl transition-all duration-300 hover:scale-[1.02] border border-white/30"
            >
              <div class="flex items-center justify-center">
                <svg class="w-4 h-4 md:w-5 md:h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-sm md:text-base">{t.labels.linkedin}</span>
              </div>
            </a>
          </div>

          <!-- Availability Status -->
          <div class="flex items-center justify-center lg:justify-start">
            <div class="w-2 h-2 md:w-3 md:h-3 bg-green-400 rounded-full mr-2 md:mr-3 animate-pulse"></div>
            <span class="text-xs md:text-sm text-gray-300">
              {t.availability}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  window.copyToClipboard = function(text, button) {
    // Add click animation
    button.style.transform = 'scale(0.95)';
    button.style.transition = 'all 0.1s ease';
    
    setTimeout(() => {
      button.style.transform = 'scale(1)';
    }, 100);
    
    navigator.clipboard.writeText(text).then(() => {
      // Show success message with animation
      const originalText = button.textContent;
      const originalClasses = button.className;
      
      // Change button appearance
      button.textContent = 'Copié !';
      button.className = button.className.replace('bg-blue-600 hover:bg-blue-700', 'bg-green-600 hover:bg-green-700');
      
      // Add success animation
      button.style.transform = 'scale(1.05)';
      button.style.boxShadow = '0 0 20px rgba(34, 197, 94, 0.5)';
      
      setTimeout(() => {
        button.style.transform = 'scale(1)';
        button.style.boxShadow = '';
      }, 200);
      
      // Reset after 2 seconds
      setTimeout(() => {
        button.textContent = originalText;
        button.className = originalClasses;
        button.style.transform = 'scale(1)';
        button.style.boxShadow = '';
      }, 2000);
      
    }).catch(() => {
      // Fallback for older browsers
      const textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'fixed';
      textArea.style.left = '-999999px';
      textArea.style.top = '-999999px';
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      
      try {
        document.execCommand('copy');
        
        // Show success message for fallback
        const originalText = button.textContent;
        const originalClasses = button.className;
        
        button.textContent = 'Copié !';
        button.className = button.className.replace('bg-blue-600 hover:bg-blue-700', 'bg-green-600 hover:bg-green-700');
        
        // Add success animation
        button.style.transform = 'scale(1.05)';
        button.style.boxShadow = '0 0 20px rgba(34, 197, 94, 0.5)';
        
        setTimeout(() => {
          button.style.transform = 'scale(1)';
          button.style.boxShadow = '';
        }, 200);
        
        // Reset after 2 seconds
        setTimeout(() => {
          button.textContent = originalText;
          button.className = originalClasses;
          button.style.transform = 'scale(1)';
          button.style.boxShadow = '';
        }, 2000);
        
      } catch (err) {
        console.error('Failed to copy text: ', err);
        button.textContent = 'Erreur';
        button.className = button.className.replace('bg-blue-600 hover:bg-blue-700', 'bg-red-600 hover:bg-red-700');
        
        setTimeout(() => {
          button.textContent = originalText;
          button.className = originalClasses;
        }, 2000);
      }
      
      document.body.removeChild(textArea);
    });
  }
</script>
