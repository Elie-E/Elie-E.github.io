                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-base md:text-lg font-semibold text-white">{t.labels.email}</h3>
                  <p class="text-sm md:text-base text-gray-300">{contactInfo.email}</p>
                </div>
              </div>
              <button 
                onclick={`copyToClipboard('${contactInfo.email}', this)`}
                class="px-3 py-2 md:px-4 md:py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-all duration-200 text-xs md:text-sm font-medium copy-btn"
              >
                {t.labels.copy}
              </button>
            </div>
          </div>
        </div>

        <!-- LinkedIn -->
        <div class="group">
          <div class="bg-white/10 backdrop-blur-sm rounded-xl md:rounded-2xl p-4 md:p-6 border border-white/20 hover:bg-white/20 transition-all duration-300 hover:scale-[1.02]">
