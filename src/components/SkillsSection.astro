---
import { getSkillsData } from '../data/index.js';

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const skillsData = getSkillsData();

const translations = {
  en: {
    title: 'Technical Skills',
    subtitle: 'Full-stack developer with a strong PHP/Laravel foundation and hands-on experience across frontend, backend, databases, deployment, automation and AI-assisted development.',
    pillars: [
      { key: 'backend', label: 'Backend', color: 'indigo', tags: skillsData.backend },
      { key: 'frontend', label: 'Frontend', color: 'cyan', tags: skillsData.frontend },
      { key: 'databases', label: 'Databases', color: 'green', tags: skillsData.databases },
      { key: 'devops', label: 'DevOps & Infrastructure', color: 'orange', tags: skillsData.devops },
      { key: 'mobile', label: 'Mobile', color: 'rose', tags: skillsData.mobile },
      { key: 'automation', label: 'Automation', color: 'slate', tags: skillsData.automation },
      { key: 'aiAssisted', label: 'AI-Assisted Development', color: 'violet', tags: skillsData.aiAssisted },
      { key: 'web', label: 'Web & Performance', color: 'purple', tags: skillsData.web },
      { key: 'practices', label: 'Methods & Practices', color: 'teal', tags: skillsData.practices },
      { key: 'languages', label: 'Languages', color: 'blue', tags: ['🇫🇷 French - Native', '🇬🇧 English - Fluent', '🇪🇸 Spanish - Fluent'] },
      { key: 'certifications', label: 'Certifications', color: 'amber', tags: skillsData.certifications },
    ],
    exploringLabel: 'Currently Learning',
    exploringDesc: 'Java, software architecture, advanced DevOps and cloud infrastructure.',
  },
  fr: {
    title: 'Compétences Techniques',
    subtitle: 'Profil full-stack polyvalent, de l\'architecture applicative au développement assisté par IA.',
    pillars: [
      { key: 'backend', label: 'Backend', color: 'indigo', tags: skillsData.backend },
      { key: 'frontend', label: 'Frontend', color: 'cyan', tags: skillsData.frontend },
      { key: 'databases', label: 'Bases de données', color: 'green', tags: skillsData.databases },
      { key: 'devops', label: 'DevOps & Infrastructure', color: 'orange', tags: skillsData.devops },
      { key: 'mobile', label: 'Mobile', color: 'rose', tags: skillsData.mobile },
      { key: 'automation', label: 'Automatisation', color: 'slate', tags: skillsData.automation },
      { key: 'aiAssisted', label: 'Développement assisté par IA', color: 'violet', tags: skillsData.aiAssisted },
      { key: 'web', label: 'Web & Performance', color: 'purple', tags: skillsData.web },
      { key: 'practices', label: 'Méthodes & pratiques', color: 'teal', tags: skillsData.practices },
      { key: 'languages', label: 'Langues', color: 'blue', tags: ['🇫🇷 Français - Natif', '🇬🇧 Anglais - Courant', '🇪🇸 Espagnol - Courant'] },
      { key: 'certifications', label: 'Certifications', color: 'amber', tags: skillsData.certifications },
    ],
    exploringLabel: 'En cours d\'apprentissage',
    exploringDesc: 'Java, architecture logicielle, DevOps avancé et cloud.',
  },
  es: {
    title: 'Habilidades Técnicas',
    subtitle: 'Perfil full-stack versátil, de la arquitectura de aplicaciones al desarrollo asistido por IA.',
    pillars: [
      { key: 'backend', label: 'Backend', color: 'indigo', tags: skillsData.backend },
      { key: 'frontend', label: 'Frontend', color: 'cyan', tags: skillsData.frontend },
      { key: 'databases', label: 'Bases de datos', color: 'green', tags: skillsData.databases },
      { key: 'devops', label: 'DevOps & Infraestructura', color: 'orange', tags: skillsData.devops },
      { key: 'mobile', label: 'Mobile', color: 'rose', tags: skillsData.mobile },
      { key: 'automation', label: 'Automatización', color: 'slate', tags: skillsData.automation },
      { key: 'aiAssisted', label: 'Desarrollo asistido por IA', color: 'violet', tags: skillsData.aiAssisted },
      { key: 'web', label: 'Web y Rendimiento', color: 'purple', tags: skillsData.web },
      { key: 'practices', label: 'Métodos y prácticas', color: 'teal', tags: skillsData.practices },
      { key: 'languages', label: 'Idiomas', color: 'blue', tags: ['🇫🇷 Francés - Nativo', '🇬🇧 Inglés - Fluido', '🇪🇸 Español - Fluido'] },
      { key: 'certifications', label: 'Certificaciones', color: 'amber', tags: skillsData.certifications },
    ],
    exploringLabel: 'Aprendiendo actualmente',
    exploringDesc: 'Java, arquitectura de software, DevOps avanzado y cloud.',
  },
};

const colorMap: Record<string, { card: string; badge: string; heading: string }> = {
  blue:   { card: 'from-blue-50 to-blue-100 border-blue-200',   badge: 'bg-blue-100 text-blue-800',   heading: 'text-blue-700' },
  cyan:   { card: 'from-cyan-50 to-cyan-100 border-cyan-200',   badge: 'bg-cyan-100 text-cyan-800',   heading: 'text-cyan-700' },
  indigo: { card: 'from-indigo-50 to-indigo-100 border-indigo-200', badge: 'bg-indigo-100 text-indigo-800', heading: 'text-indigo-700' },
  green:  { card: 'from-green-50 to-green-100 border-green-200', badge: 'bg-green-100 text-green-800', heading: 'text-green-700' },
  orange: { card: 'from-orange-50 to-orange-100 border-orange-200', badge: 'bg-orange-100 text-orange-800', heading: 'text-orange-700' },
  purple: { card: 'from-purple-50 to-purple-100 border-purple-200', badge: 'bg-purple-100 text-purple-800', heading: 'text-purple-700' },
  teal:   { card: 'from-teal-50 to-teal-100 border-teal-200',   badge: 'bg-teal-100 text-teal-800',   heading: 'text-teal-700' },
  rose:   { card: 'from-rose-50 to-rose-100 border-rose-200',   badge: 'bg-rose-100 text-rose-800',   heading: 'text-rose-700' },
  slate:  { card: 'from-slate-50 to-slate-100 border-slate-200', badge: 'bg-slate-100 text-slate-800', heading: 'text-slate-700' },
  amber:  { card: 'from-amber-50 to-amber-100 border-amber-200', badge: 'bg-amber-100 text-amber-800', heading: 'text-amber-700' },
  violet: { card: 'from-violet-50 to-violet-100 border-violet-200', badge: 'bg-violet-100 text-violet-800', heading: 'text-violet-700' },
};

const t = translations[lang as keyof typeof translations] || translations.en;
---

<section class="py-20 bg-white">
  <div class="container mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center mb-14">
      <h2 class="text-4xl font-bold bg-gradient-to-r from-blue-600 to-cyan-600 bg-clip-text text-transparent mb-4">
        {t.title}
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        {t.subtitle}
      </p>
    </div>

    <!-- Skill Pillars Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {t.pillars.map(pillar => {
        const c = colorMap[pillar.color];
        return (
          <div class={`bg-gradient-to-br ${c.card} rounded-2xl p-6 border`}>
            <h3 class={`text-sm font-bold uppercase tracking-wider mb-4 ${c.heading}`}>{pillar.label}</h3>
            <div class="flex flex-wrap gap-2">
              {pillar.tags.map(tag => (
                <span class={`px-2.5 py-1 text-xs font-medium rounded-full ${c.badge}`}>{tag}</span>
              ))}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Currently Exploring -->
    <div class="mt-10">
      <div class="bg-gradient-to-r from-slate-50 to-blue-50 rounded-2xl p-6 border border-slate-200">
        <div class="flex flex-wrap items-start gap-6">
          <div class="flex-1 min-w-0">
            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500 mb-2">{t.exploringLabel}</h3>
            <p class="text-sm text-gray-600 mb-3">{t.exploringDesc}</p>
            <div class="flex flex-wrap gap-2">
              {skillsData.exploring.map(tag => (
                <span class="px-2.5 py-1 text-xs font-medium rounded-full bg-slate-100 text-slate-700 border border-slate-200">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
