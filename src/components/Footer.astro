---
import { languages } from '../types/index.js';
import { getPersonalInfo } from '../data/index.js';

export interface Props {
  currentLang: string;
}

const { currentLang } = Astro.props;
const personalInfo = getPersonalInfo(currentLang);

// Get current year dynamically
const currentYear = new Date().getFullYear();

// Footer text translations
const footerText = {
  en: { 
    rights: 'All rights reserved',
    description: 'Full-Stack Developer focused on building practical, maintainable web applications.',
    navigation: 'Navigation',
    contact: 'Contact',
    home: 'Home',
    resume: 'Resume',
    portfolio: 'Portfolio',
    blog: 'Blog',
    about: 'About',
    contact_link: 'Contact',
    location: 'France / Mexico',
    linkedin: 'LinkedIn'
  },
  fr: { 
    rights: 'Tous droits réservés',
    description: 'Développeur Full-Stack orienté vers la conception d\'applications web pratiques et maintenables.',
    navigation: 'Navigation',
    contact: 'Contact',
    home: 'Accueil',
    resume: 'CV',
    portfolio: 'Portfolio',
    blog: 'Blog',
    about: 'À propos',
    contact_link: 'Contact',
    location: 'France / Mexique',
    linkedin: 'LinkedIn'
  },
  es: { 
    rights: 'Todos los derechos reservados',
    description: 'Desarrollador Full-Stack enfocado en construir aplicaciones web prácticas y mantenibles.',
    navigation: 'Navegación',
    contact: 'Contacto',
    home: 'Inicio',
    resume: 'Currículum',
    portfolio: 'Portafolio',
    blog: 'Blog',
    about: 'Acerca de',
    contact_link: 'Contacto',
    location: 'Francia / Mexico',
    linkedin: 'LinkedIn'
  }
};

const currentFooter = footerText[currentLang as keyof typeof footerText] || footerText.en;
---

<footer class="bg-gradient-to-r from-gray-900 via-blue-900 to-gray-900 text-white">
  <div class="container mx-auto px-6 py-12">
    <div class="grid md:grid-cols-4 gap-8">
      <!-- Brand & Description -->
      <div class="md:col-span-2">
        <h3 class="text-2xl font-bold bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent mb-4">
          {personalInfo.name}
        </h3>
        <p class="text-gray-300 mb-6 max-w-md leading-relaxed">
          {currentFooter.description}
        </p>
        <div class="flex space-x-4">
          <a 
            href={`/${currentLang}/services`}
            class="text-gray-400 hover:text-blue-400 transition-all duration-300 hover:scale-110"
            aria-label="Services page"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
            </svg>
          </a>
          <!-- Github link -->
          <!-- <a 
            href="https://github.com/Elie-E" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-gray-400 hover:text-blue-400 transition-all duration-300 hover:scale-110"
            aria-label="Visit GitHub profile"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd"></path>
            </svg>
          </a> -->
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-lg font-semibold text-blue-400 mb-6">{currentFooter.navigation}</h4>
        <ul class="space-y-3">
          <li><a href={`/${currentLang}`} class="text-gray-300 hover:text-blue-400 transition-colors duration-200 hover:translate-x-1 inline-block">{currentFooter.home}</a></li>
          <li><a href={`/${currentLang}/resume`} class="text-gray-300 hover:text-blue-400 transition-colors duration-200 hover:translate-x-1 inline-block">{currentFooter.resume}</a></li>
          <li><a href={`/${currentLang}/portfolio`} class="text-gray-300 hover:text-blue-400 transition-colors duration-200 hover:translate-x-1 inline-block">{currentFooter.portfolio}</a></li>
          <li><a href={`/${currentLang}/about`} class="text-gray-300 hover:text-blue-400 transition-colors duration-200 hover:translate-x-1 inline-block">{currentFooter.about}</a></li>
          <li><a href={`/${currentLang}/contact`} class="text-gray-300 hover:text-blue-400 transition-colors duration-200 hover:translate-x-1 inline-block">{currentFooter.contact_link}</a></li>
          <li><a href={`/${currentLang}/services`} class="text-gray-300 hover:text-blue-400 transition-colors duration-200 hover:translate-x-1 inline-block">Services</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="text-lg font-semibold text-blue-400 mb-6">{currentFooter.contact}</h4>
        <div class="space-y-3 text-gray-300">
          <div class="flex items-center space-x-3">
            <svg class="w-5 h-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
            </svg>
            <span>{currentFooter.location}</span>
          </div>
          <div class="flex items-center space-x-3">
            <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
            </svg>
            <a href={`/${currentLang}/services`} class="hover:text-blue-400 transition-colors duration-200">
              Services
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-700 mt-12 pt-8">
      <div class="flex justify-center">
        <div class="text-gray-400">
          © {currentYear} {personalInfo.name}
        </div>
      </div>
    </div>
  </div>
</footer>
